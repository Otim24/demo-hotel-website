---
import { TESTIMONIALS } from '../data/hotelData';
---

<section class="relative py-28 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden border-t border-white/5">
  <!-- Atmospheric background image layer with glass overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=2200&q=80"
      alt="Hotel Twilight Courtyard"
      class="w-full h-full object-cover opacity-10 filter contrast-125"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-hotel-dark via-hotel-charcoal/90 to-hotel-dark"></div>
    <div class="ambient-glow bottom-0 left-1/4 opacity-20"></div>
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center max-w-xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="w-6 h-[1px] bg-hotel-gold"></span>
        <span class="text-xs uppercase tracking-[0.3em] text-hotel-gold font-semibold">Distinguished Impressions</span>
        <span class="w-6 h-[1px] bg-hotel-gold"></span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl text-hotel-sand-light tracking-tight">
        Words from Our Guests
      </h2>
    </div>

    <!-- Testimonials Layout -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      {
        TESTIMONIALS.map((t) => (
          <div class="glass-panel p-8 sm:p-10 rounded-lg border border-hotel-border/40 flex flex-col justify-between hover:border-hotel-gold/40 transition-colors duration-300">
            <div>
              <!-- Quotation Mark -->
              <svg class="w-8 h-8 text-hotel-gold/30 mb-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <p class="font-serif italic text-base sm:text-lg text-hotel-sand-light/95 leading-relaxed mb-6 font-light">
                "{t.quote}"
              </p>
            </div>

            <div class="border-t border-white/10 pt-5">
              <div class="font-sans text-sm font-semibold text-hotel-sand-light">{t.author}</div>
              <div class="text-xs text-hotel-gold mt-0.5">{t.role}</div>
              <div class="text-[11px] text-hotel-muted font-mono mt-0.5">{t.location}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

