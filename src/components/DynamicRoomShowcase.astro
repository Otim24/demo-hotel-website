---
import { ROOMS } from '../data/hotelData';
---

<section id="dynamic-rooms" class="relative py-28 px-4 sm:px-6 lg:px-12 overflow-hidden bg-hotel-dark">
  <!-- Atmospheric background image layer with glass overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1578683010236-d716f9a3f461?auto=format&fit=crop&w=2000&q=80"
      alt="Atmospheric architecture backdrop"
      class="w-full h-full object-cover opacity-15 filter brightness-50 contrast-125"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-hotel-dark via-hotel-dark/85 to-hotel-dark"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-hotel-gold/10 via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 border-b border-hotel-border/30 pb-8">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-8 h-[1px] bg-hotel-gold"></span>
          <span class="text-xs uppercase tracking-[0.3em] text-hotel-gold font-semibold">Accommodations Folio</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-hotel-sand-light tracking-tight max-w-xl">
          Curated Sanctuaries of Space & Solitude
        </h2>
      </div>

      <div class="mt-6 md:mt-0 flex flex-col sm:flex-row sm:items-center gap-4">
        <p class="text-xs sm:text-sm text-hotel-muted max-w-sm font-light">
          Each residence is built from regional granite and indigenous timber, framing the golden savanna horizon.
        </p>
        <a
          href="/rooms"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-hotel-gold hover:text-hotel-sand-light transition-colors group self-start sm:self-auto font-medium"
        >
          <span>All 24 Suites</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Room Selection Tabs (Horizontal Scrollable on Mobile) -->
    <div class="mb-10 overflow-x-auto pb-3 scrollbar-none">
      <div class="flex items-center gap-3 sm:gap-4 min-w-max" role="tablist" aria-label="Room showcases">
        {
          ROOMS.map((room, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`room-panel-${room.id}`}
              id={`room-tab-${room.id}`}
              data-tab-target={room.id}
              class={`room-tab-btn px-5 sm:px-6 py-3 rounded-full text-xs uppercase tracking-[0.18em] transition-all duration-300 font-medium flex items-center gap-3 ${
                index === 0
                  ? 'bg-hotel-gold text-hotel-dark shadow-[0_0_20px_rgba(197,160,89,0.35)]'
                  : 'glass-card text-hotel-sand/80 hover:text-hotel-gold hover:border-hotel-gold/40'
              }`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
              <span>{room.name}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Dynamic Room Presentation Panels -->
    <div class="relative min-h-[640px]">
      {
        ROOMS.map((room, index) => (
          <div
            id={`room-panel-${room.id}`}
            role="tabpanel"
            aria-labelledby={`room-tab-${room.id}`}
            class={`room-panel transition-all duration-700 ${
              index === 0 ? 'block opacity-100' : 'hidden opacity-0'
            }`}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
              <!-- Left: Immersive Visual Stage (7 Cols) -->
              <div class="lg:col-span-7 flex flex-col justify-between space-y-4">
                <div class="relative rounded-lg overflow-hidden border border-hotel-border/40 group shadow-2xl h-[420px] sm:h-[500px]">
                  <!-- Main Image -->
                  <img
                    id={`main-img-${room.id}`}
                    src={room.heroImage}
                    alt={room.name}
                    class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                    loading="lazy"
                  />

                  <!-- Dark Vignette Overlay -->
                  <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark/90 via-hotel-dark/20 to-transparent"></div>

                  <!-- Spec Badges floating on image -->
                  <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                    <span class="glass-panel text-hotel-sand-light text-[11px] font-mono tracking-widest px-3 py-1.5 rounded-sm uppercase">
                      {room.sizeSqM} SQM / {Math.round(room.sizeSqM * 10.764)} SQFT
                    </span>
                    <span class="glass-panel text-hotel-gold text-[11px] uppercase tracking-wider px-3 py-1.5 rounded-sm font-medium">
                      {room.view}
                    </span>
                  </div>

                  <!-- Floating Gallery Switcher inside Image on Desktop & Mobile -->
                  <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      {room.gallery.map((thumbUrl, tIdx) => (
                        <button
                          type="button"
                          data-img-target={thumbUrl}
                          data-parent-room={room.id}
                          class="thumb-btn w-14 h-10 rounded-sm overflow-hidden border border-white/30 hover:border-hotel-gold transition-all duration-200 focus:outline-none"
                          aria-label={`View photo ${tIdx + 1} of ${room.name}`}
                        >
                          <img src={thumbUrl} alt="" class="w-full h-full object-cover" />
                        </button>
                      ))}
                    </div>

                    <div class="glass-panel px-3.5 py-1.5 rounded-sm text-right">
                      <span class="text-[10px] uppercase tracking-wider text-hotel-muted block">Direct Tariff</span>
                      <span class="font-serif text-lg text-hotel-gold font-semibold">${room.pricePerNight}</span>
                      <span class="text-[10px] text-hotel-sand/70 uppercase"> / Night</span>
                    </div>
                  </div>
                </div>

                <!-- Architectural Spec Bar below image -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  {room.highlights.map((h) => (
                    <div class="glass-card p-3 rounded-sm border border-white/5">
                      <div class="text-[10px] uppercase tracking-wider text-hotel-muted mb-0.5">{h.label}</div>
                      <div class="text-xs font-medium text-hotel-sand-light font-sans truncate">{h.value}</div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Right: Editorial Narrative & Specifications Card (5 Cols) -->
              <div class="lg:col-span-5 flex flex-col justify-between glass-panel p-6 sm:p-8 lg:p-10 rounded-lg border border-hotel-border/40 shadow-xl">
                <div>
                  <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
                    <span class="text-xs font-mono uppercase tracking-[0.25em] text-hotel-gold">
                      Category: {room.category.toUpperCase()}
                    </span>
                    <span class="text-xs text-hotel-sand/80 font-sans">{room.occupancy}</span>
                  </div>

                  <h3 class="font-serif text-2xl sm:text-3xl text-hotel-sand-light mb-3 tracking-wide">
                    {room.name}
                  </h3>

                  <p class="text-xs font-sans uppercase tracking-wider text-hotel-gold/90 mb-5 font-medium leading-relaxed">
                    {room.tagline}
                  </p>

                  <p class="text-sm text-hotel-muted/95 leading-relaxed font-light mb-8">
                    {room.description}
                  </p>

                  <div class="border-t border-white/10 pt-6 mb-8">
                    <h4 class="text-[11px] uppercase tracking-[0.25em] text-hotel-sand-light font-semibold mb-4">
                      Signature Appointments
                    </h4>
                    <ul class="space-y-2.5">
                      {room.amenities.map((amenity) => (
                        <li class="flex items-start gap-3 text-xs text-hotel-sand/90">
                          <svg class="w-4 h-4 text-hotel-gold flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{amenity}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Action CTA -->
                <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                  <button
                    type="button"
                    data-open-reserve-modal
                    data-room-id={room.id}
                    class="flex-1 bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold py-3.5 px-6 rounded-sm transition-all duration-300 text-center shadow-lg hover:shadow-[0_0_20px_rgba(197,160,89,0.35)]"
                  >
                    Reserve This Sanctuary
                  </button>

                  <a
                    href={`/rooms#${room.id}`}
                    class="glass-card hover:border-hotel-gold text-hotel-sand-light font-sans text-xs tracking-[0.18em] uppercase font-medium py-3.5 px-5 rounded-sm transition-colors text-center"
                  >
                    Full Room Folio
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Tab switching logic with silky smooth fade in / out
  const tabButtons = document.querySelectorAll('.room-tab-btn');
  const panels = document.querySelectorAll('.room-panel');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab-target');
      if (!targetId) return;

      // Update button states
      tabButtons.forEach((b) => {
        b.setAttribute('aria-selected', 'false');
        b.classList.remove('bg-hotel-gold', 'text-hotel-dark', 'shadow-[0_0_20px_rgba(197,160,89,0.35)]');
        b.classList.add('glass-card', 'text-hotel-sand/80');
      });

      btn.setAttribute('aria-selected', 'true');
      btn.classList.add('bg-hotel-gold', 'text-hotel-dark', 'shadow-[0_0_20px_rgba(197,160,89,0.35)]');
      btn.classList.remove('glass-card', 'text-hotel-sand/80');

      // Fade out active panel and fade in target panel
      panels.forEach((panel) => {
        const isTarget = panel.id === `room-panel-${targetId}`;
        if (isTarget) {
          panel.classList.remove('hidden');
          setTimeout(() => {
            panel.classList.remove('opacity-0');
            panel.classList.add('opacity-100');
          }, 30);
        } else {
          panel.classList.remove('opacity-100');
          panel.classList.add('opacity-0');
          setTimeout(() => {
            panel.classList.add('hidden');
          }, 300);
        }
      });
    });
  });

  // Thumbnail switcher inside each room view
  const thumbButtons = document.querySelectorAll('.thumb-btn');
  thumbButtons.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const parentRoom = thumb.getAttribute('data-parent-room');
      const targetImgSrc = thumb.getAttribute('data-img-target');
      if (!parentRoom || !targetImgSrc) return;

      const mainImg = document.getElementById(`main-img-${parentRoom}`) as HTMLImageElement;
      if (mainImg) {
        mainImg.style.opacity = '0.3';
        setTimeout(() => {
          mainImg.src = targetImgSrc;
          mainImg.style.opacity = '1';
        }, 180);
      }
    });
  });
</script>
