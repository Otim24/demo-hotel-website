---
import { HOTEL_AMENITIES } from '../data/hotelData';

const poolAmenity = HOTEL_AMENITIES.find((a) => a.id === 'horizon-swimming-pool') || HOTEL_AMENITIES[0];
const triAmenities = HOTEL_AMENITIES.filter((a) => a.id !== 'horizon-swimming-pool');
---

<section id="amenities" class="relative py-28 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden border-t border-white/5">
  <!-- Atmospheric background glow & subtle texture -->
  <div class="ambient-glow bottom-0 right-0 opacity-20 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10 space-y-16">
    <!-- Header: Editorial Masthead -->
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-hotel-border/30 pb-8 kinetic-block">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-8 h-[1px] bg-hotel-gold"></span>
          <span class="text-xs uppercase tracking-[0.3em] text-hotel-gold font-semibold">Hotel Life & Leisure</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-hotel-sand-light tracking-tight max-w-xl">
          Wellness, Rejuvenation & Quiet Solitude
        </h2>
      </div>

      <div class="mt-6 md:mt-0 max-w-md">
        <p class="text-xs sm:text-sm text-hotel-muted font-light leading-relaxed mb-4">
          From our 30-meter heated horizon lap pool and holistic hydrotherapy spa to 24-hour Technogym fitness and the executive library salon.
        </p>
        <a
          href="/amenities"
          class="text-xs uppercase tracking-[0.2em] text-hotel-gold hover:text-hotel-sand-light font-semibold transition-colors inline-flex items-center gap-2"
        >
          <span>Explore All Hotel Facilities</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- 1. MASTER PANORAMA: 30-Meter Heated Horizon Lap Pool -->
    <div class="relative rounded-xl overflow-hidden border border-hotel-border/50 shadow-2xl group kinetic-block">
      <div class="relative h-[440px] sm:h-[500px] lg:h-[540px] w-full overflow-hidden">
        <img
          src={poolAmenity.image}
          alt={poolAmenity.title}
          class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
          loading="lazy"
        />
        <!-- Deep luxury dark vignette -->
        <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/40 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-hotel-dark/80 via-transparent to-transparent"></div>

        <!-- Top Badges -->
        <div class="absolute top-6 left-6 sm:left-8 flex flex-wrap items-center gap-2.5">
          <span class="glass-panel text-hotel-gold text-[10px] uppercase tracking-widest px-3 py-1.5 rounded-sm font-semibold border border-hotel-gold/30">
            {poolAmenity.badge}
          </span>
          <span class="glass-panel text-hotel-sand-light text-[10px] font-mono px-3 py-1.5 rounded-sm">
            {poolAmenity.category}
          </span>
          <span class="hidden sm:inline-flex items-center gap-2 glass-panel text-[10px] font-mono text-emerald-400 px-3 py-1.5 rounded-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>{poolAmenity.hours}</span>
          </span>
        </div>

        <!-- Floating Architectural Spec HUD (Top Right on desktop) -->
        <div class="hidden lg:grid grid-cols-2 gap-3 absolute top-6 right-8 max-w-sm">
          <div class="glass-panel p-3.5 rounded-lg border border-white/10 backdrop-blur-md">
            <div class="text-[10px] uppercase tracking-wider text-hotel-muted font-mono">Lap Length</div>
            <div class="text-sm font-serif text-hotel-sand-light font-semibold mt-0.5">30 Meters Basalt Tile</div>
          </div>
          <div class="glass-panel p-3.5 rounded-lg border border-white/10 backdrop-blur-md">
            <div class="text-[10px] uppercase tracking-wider text-hotel-muted font-mono">Water Climate</div>
            <div class="text-sm font-serif text-hotel-sand-light font-semibold mt-0.5">28°C Constant Heated</div>
          </div>
          <div class="glass-panel p-3.5 rounded-lg border border-white/10 backdrop-blur-md">
            <div class="text-[10px] uppercase tracking-wider text-hotel-muted font-mono">Cabana Service</div>
            <div class="text-sm font-serif text-hotel-sand-light font-semibold mt-0.5">Private Valet & Dining</div>
          </div>
          <div class="glass-panel p-3.5 rounded-lg border border-white/10 backdrop-blur-md">
            <div class="text-[10px] uppercase tracking-wider text-hotel-muted font-mono">Admission</div>
            <div class="text-sm font-serif text-hotel-sand-light font-semibold mt-0.5">Complimentary for Guests</div>
          </div>
        </div>

        <!-- Master Content Overlay (Bottom) -->
        <div class="absolute bottom-6 sm:bottom-8 left-6 sm:left-8 right-6 sm:right-8 max-w-2xl space-y-4">
          <div>
            <span class="text-xs uppercase tracking-[0.25em] text-hotel-gold font-mono block mb-1">
              Architectural Centerpiece
            </span>
            <h3 class="font-serif text-2xl sm:text-4xl text-hotel-sand-light font-medium tracking-tight">
              {poolAmenity.title}
            </h3>
            <p class="text-xs sm:text-sm text-hotel-sand/90 font-light leading-relaxed mt-2 max-w-xl">
              {poolAmenity.description}
            </p>
          </div>

          <!-- Highlight Tags -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            {poolAmenity.highlights.map((h) => (
              <span class="inline-flex items-center gap-1.5 text-[11px] text-hotel-sand bg-black/40 backdrop-blur-md border border-white/10 px-3 py-1 rounded-sm">
                <span class="w-1 h-1 rounded-full bg-hotel-gold"></span>
                <span>{h}</span>
              </span>
            ))}
          </div>

          <!-- Action Button -->
          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href="/amenities#horizon-swimming-pool"
              class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold py-3 px-6 rounded-sm transition-colors shadow-lg"
            >
              Explore Pool & Cabanas
            </a>
            <span class="text-xs text-hotel-muted font-mono">
              Heated waters open daily from 06:00 to 21:00
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. ARCHITECTURAL TRI-FOLIO: 3 Distinct Vertical Editorial Folios (No generic 2x2 grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 kinetic-stagger-parent">
      {
        triAmenities.map((amenity, idx) => (
          <div class="glass-panel rounded-xl overflow-hidden border border-hotel-border/40 hover:border-hotel-gold/50 transition-all duration-500 group flex flex-col justify-between kinetic-card">
            <div>
              <!-- Photography Stage with Aspect Framing -->
              <div class="relative h-60 sm:h-64 overflow-hidden">
                <img
                  src={amenity.image}
                  alt={amenity.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/30 to-transparent"></div>

                <div class="absolute top-4 left-4 flex gap-2">
                  <span class="glass-panel text-hotel-gold text-[10px] uppercase tracking-widest px-3 py-1 rounded-sm font-semibold border border-hotel-gold/20">
                    {amenity.badge}
                  </span>
                </div>

                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between">
                  <span class="text-[10px] uppercase tracking-wider text-hotel-sand font-mono bg-black/50 backdrop-blur-sm px-2.5 py-1 rounded-sm">
                    {amenity.hours}
                  </span>
                  <span class="text-[10px] font-mono text-hotel-gold/90">
                    0{idx + 2} Folio
                  </span>
                </div>
              </div>

              <!-- Editorial Narrative Content -->
              <div class="p-6 sm:p-7 space-y-4">
                <div>
                  <div class="text-[10px] uppercase tracking-[0.25em] text-hotel-gold font-semibold mb-1">
                    {amenity.subtitle}
                  </div>
                  <h3 class="font-serif text-xl sm:text-2xl text-hotel-sand-light group-hover:text-hotel-gold transition-colors">
                    {amenity.title}
                  </h3>
                </div>

                <p class="text-xs sm:text-sm text-hotel-muted font-light leading-relaxed">
                  {amenity.description}
                </p>

                <!-- Architectural Provision Highlights -->
                <div class="border-t border-white/10 pt-4 space-y-2">
                  <div class="text-[10px] uppercase tracking-[0.2em] text-hotel-gold font-semibold">
                    Key Provisions
                  </div>
                  <ul class="space-y-1.5">
                    {amenity.highlights.map((item) => (
                      <li class="flex items-start gap-2 text-xs text-hotel-sand/85">
                        <svg class="w-3.5 h-3.5 text-hotel-gold flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar with Clear Action -->
            <div class="p-5 sm:px-7 border-t border-white/10 flex items-center justify-between bg-black/25">
              <span class="text-[10px] font-mono text-hotel-muted">
                Resident Privilege Included
              </span>
              <a
                href={amenity.id === 'aswa-wellness-spa' ? '/amenities#spa-inquiry' : '/amenities'}
                class="text-xs uppercase tracking-[0.18em] text-hotel-gold hover:text-hotel-sand-light font-semibold transition-colors flex items-center gap-1.5"
              >
                <span>{amenity.id === 'aswa-wellness-spa' ? 'Spa Menu & Reserve' : 'View Facility'}</span>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
