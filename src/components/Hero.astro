---
import { ROOMS } from '../data/hotelData';

const heroSlides = [
  {
    id: 1,
    image: 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2400&q=85',
    tag: 'Architectural Sanctuary',
    title: 'Where Architectural Restraint Meets Refined Grace',
    description: 'Situated along historic Churchill Way in Gulu Central. An architectural sanctuary crafted from local volcanic stone and hand-hewn mahogany, offering executive discretion and serene northern vistas.',
    alt: 'The Northern Hotel grand twilight estate architecture and reflective waters',
    caption: 'Estate Twilight Elevation',
    primaryCta: 'Reserve Your Stay',
    primaryHref: '/reserve',
    secondaryCta: 'Explore Accommodations',
    secondaryHref: '/rooms',
  },
  {
    id: 2,
    image: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=2400&q=85',
    tag: 'Presidential Suites',
    title: 'Sanctuaries of Quiet Volcanic Stone & Mahogany',
    description: 'Bespoke suites framed with acoustic double-glazing, expansive veranda daybeds, hand-woven Acholi textiles, and dedicated round-the-clock butler service.',
    alt: 'The Northern luxury presidential suite with panoramic views',
    caption: 'Horizon Presidential Suite',
    primaryCta: 'Reserve Suite',
    primaryHref: '/reserve',
    secondaryCta: 'View Suites Folio',
    secondaryHref: '/rooms',
  },
  {
    id: 3,
    image: 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=2400&q=85',
    tag: 'Horizon Wellness',
    title: 'Restoration Beneath the Vast Northern Sky',
    description: 'Our 30-meter heated lap pool and the Aswa Holistic Spa provide hydrotherapy rituals and physical restoration after executive travel.',
    alt: '30-meter heated horizon lap pool with private cabanas',
    caption: '30m Heated Horizon Pool',
    primaryCta: 'Book Experience',
    primaryHref: '/reserve',
    secondaryCta: 'Discover Amenities',
    secondaryHref: '/amenities',
  },
  {
    id: 4,
    image: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=2400&q=85',
    tag: 'Northern Gastronomy',
    title: 'Wood-Fired Gastronomy & Rare Reserve Cellar',
    description: 'Heirloom grains, pasture-raised regional cuts, and smoked freshwater catches transformed over living wood fire at The Savanna Hearth.',
    alt: 'The Savanna Hearth open ember dining room atmosphere',
    caption: 'The Savanna Hearth',
    primaryCta: 'Reserve Table',
    primaryHref: '/dining',
    secondaryCta: 'Explore Gastronomy',
    secondaryHref: '/dining',
  },
  {
    id: 5,
    image: 'https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=2400&q=85',
    tag: 'Private Villas',
    title: 'Secluded Villa Sanctuaries with Enclosed Courtyards',
    description: 'Stand-alone garden villas featuring open-air rainfall baths, private plunge pools, and secluded basalt walled gardens for complete privacy.',
    alt: 'Acholi garden villa bedroom opening onto private stone courtyard',
    caption: 'Acholi Garden Villa',
    primaryCta: 'Reserve Villa',
    primaryHref: '/reserve',
    secondaryCta: 'Explore Private Villas',
    secondaryHref: '/rooms',
  },
  {
    id: 6,
    image: 'https://images.unsplash.com/photo-1551218808-94e220e084d2?auto=format&fit=crop&w=2400&q=85',
    tag: 'Sunset Libations',
    title: 'Dusk Libations Overlooking the Karuma Ridge',
    description: 'Bespoke botanical aperitifs, single-malt scotch, and sunset fire-pit lounges perched on Churchill Terrace above Gulu Central.',
    alt: 'Churchill Terrace and bar overlooking twilight northern skyline',
    caption: 'Churchill Terrace & Bar',
    primaryCta: 'Reserve Evening',
    primaryHref: '/dining',
    secondaryCta: 'View Lounges',
    secondaryHref: '/dining',
  },
];
---

<section
  id="hero-carousel-section"
  class="relative min-h-[96vh] lg:min-h-screen flex flex-col justify-between pt-32 pb-10 px-4 sm:px-6 lg:px-12 overflow-hidden bg-hotel-dark select-none"
  aria-label="Hotel Highlights Carousel"
>
  <!-- 6-Image Cinematic Carousel Background Layer -->
  <div class="absolute inset-0 z-0 overflow-hidden" id="hero-slides-container">
    {
      heroSlides.map((slide, idx) => (
        <div
          class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
            idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
          }`}
          data-slide-index={idx}
        >
          <img
            src={slide.image}
            alt={slide.alt}
            class={`hero-slide-img w-full h-full object-cover object-center filter brightness-[0.70] contrast-[1.12] transition-transform duration-[7000ms] ease-out ${
              idx === 0 ? 'scale-105' : 'scale-100'
            }`}
            loading={idx === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <!-- Deep luxury multi-angle vignettes for maximum typography contrast -->
          <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/45 to-hotel-dark/75"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-hotel-dark/85 via-transparent to-hotel-dark/65"></div>
        </div>
      ))
    }
  </div>

  <!-- Ambient light glow -->
  <div class="ambient-glow top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 opacity-25 pointer-events-none"></div>

  <!-- Desktop Floating Prev / Next Arrow Controls -->
  <button
    type="button"
    id="hero-carousel-prev"
    class="hidden md:flex absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full glass-panel-heavy border border-white/15 hover:border-hotel-gold text-hotel-sand hover:text-hotel-gold items-center justify-center transition-all duration-300 shadow-2xl hover:scale-105 active:scale-95 cursor-pointer focus:outline-none"
    aria-label="Previous Slide"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button
    type="button"
    id="hero-carousel-next"
    class="hidden md:flex absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full glass-panel-heavy border border-white/15 hover:border-hotel-gold text-hotel-sand hover:text-hotel-gold items-center justify-center transition-all duration-300 shadow-2xl hover:scale-105 active:scale-95 cursor-pointer focus:outline-none"
    aria-label="Next Slide"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Top spacing anchor -->
  <div></div>

  <!-- Dynamic Center Hero Text Content (Transitions with Active Slide) -->
  <div class="relative z-10 max-w-5xl mx-auto text-center py-6 sm:py-12 flex-grow flex items-center justify-center">
    <div class="relative w-full">
      {
        heroSlides.map((slide, idx) => (
          <div
            class={`hero-text-item transition-all duration-700 ease-out ${
              idx === 0
                ? 'opacity-100 translate-y-0 relative'
                : 'opacity-0 translate-y-4 absolute inset-0 pointer-events-none'
            }`}
            data-text-index={idx}
          >
            <!-- Category Tag -->
            <div class="inline-flex items-center gap-2 glass-panel px-3.5 py-1 rounded-full mb-4 border border-hotel-gold/30">
              <span class="w-1.5 h-1.5 rounded-full bg-hotel-gold animate-pulse"></span>
              <span class="text-[10px] sm:text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold">
                {slide.tag}
              </span>
            </div>

            <!-- Slide Headline -->
            <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl lg:text-7xl text-hotel-sand-light tracking-tight font-normal leading-[1.08] mb-5 drop-shadow-xl max-w-4xl mx-auto">
              {slide.title}
            </h1>

            <!-- Slide Description -->
            <p class="max-w-2xl mx-auto text-xs sm:text-base md:text-lg text-hotel-sand/90 font-light font-sans leading-relaxed mb-8 drop-shadow">
              {slide.description}
            </p>

            <!-- Action CTAs -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
              <button
                type="button"
                data-open-reserve-modal
                class="w-full sm:w-auto bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.25em] uppercase font-semibold py-3.5 sm:py-4 px-8 sm:px-9 rounded-sm transition-all duration-300 shadow-2xl hover:shadow-[0_0_25px_rgba(197,160,89,0.45)] cursor-pointer"
              >
                {slide.primaryCta}
              </button>

              <a
                href={slide.secondaryHref}
                class="w-full sm:w-auto glass-panel hover:bg-white/10 text-hotel-sand-light font-sans text-xs tracking-[0.2em] uppercase font-medium py-3.5 sm:py-4 px-8 rounded-sm transition-all duration-300 text-center"
              >
                {slide.secondaryCta}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Bottom Interactive Carousel Navigation HUD -->
  <div class="relative z-10 max-w-5xl mx-auto w-full mb-5">
    <div class="flex items-center justify-between gap-3 glass-panel-heavy px-4 sm:px-6 py-2.5 rounded-full border border-hotel-border/40 shadow-xl">
      <!-- Left: Mobile Arrow + Slide Caption & Counter -->
      <div class="flex items-center gap-2 sm:gap-3">
        <button
          type="button"
          id="hero-mobile-prev"
          class="flex md:hidden w-8 h-8 rounded-full glass-panel text-hotel-sand hover:text-hotel-gold items-center justify-center cursor-pointer focus:outline-none"
          aria-label="Previous Slide"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <span id="hero-slide-counter" class="font-mono text-xs text-hotel-gold font-semibold tracking-wider whitespace-nowrap">
          01 / 06
        </span>
        <span class="text-white/20 hidden xs:inline">|</span>
        <span id="hero-slide-caption" class="font-serif italic text-xs text-hotel-sand-light truncate max-w-[150px] sm:max-w-xs">
          {heroSlides[0].caption}
        </span>
      </div>

      <!-- Center: Segmented Interactive Progress Indicators (Clickable) -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        {
          heroSlides.map((_, idx) => (
            <button
              type="button"
              class="hero-indicator-btn group relative h-2 sm:h-2.5 w-6 sm:w-10 rounded-full bg-white/15 overflow-hidden transition-all duration-300 hover:bg-white/30 cursor-pointer focus:outline-none"
              data-indicator-index={idx}
              aria-label={`Jump to slide ${idx + 1}`}
            >
              <span
                class={`hero-indicator-bar absolute inset-0 bg-hotel-gold rounded-full origin-left transition-transform duration-300 ${
                  idx === 0 ? 'scale-x-100' : 'scale-x-0'
                }`}
              ></span>
            </button>
          ))
        }
      </div>

      <!-- Right: Mobile Next Arrow + Autoplay Status -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="hero-autoplay-toggle"
          class="hidden sm:flex items-center gap-1.5 text-[10px] uppercase font-mono tracking-widest text-hotel-muted hover:text-hotel-gold transition-colors focus:outline-none cursor-pointer"
          aria-label="Toggle Autoplay"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" id="hero-autoplay-indicator"></span>
          <span id="hero-autoplay-text">Autoplay</span>
        </button>

        <button
          type="button"
          id="hero-mobile-next"
          class="flex md:hidden w-8 h-8 rounded-full glass-panel text-hotel-sand hover:text-hotel-gold items-center justify-center cursor-pointer focus:outline-none"
          aria-label="Next Slide"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Glassmorphic Booking Search Bar (Integrated at Bottom) -->
  <div class="relative z-10 max-w-6xl w-full mx-auto">
    <div class="glass-panel-heavy p-4 sm:p-6 rounded-lg shadow-2xl border border-hotel-border/50">
      <form id="hero-quick-book" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
        <div>
          <label for="hero-checkin" class="block text-[11px] uppercase tracking-[0.2em] text-hotel-gold font-medium mb-1.5">
            Arrival Date
          </label>
          <input
            type="date"
            id="hero-checkin"
            class="w-full glass-input px-3 py-2.5 rounded-sm text-xs text-hotel-sand font-mono"
            required
          />
        </div>

        <div>
          <label for="hero-checkout" class="block text-[11px] uppercase tracking-[0.2em] text-hotel-gold font-medium mb-1.5">
            Departure Date
          </label>
          <input
            type="date"
            id="hero-checkout"
            class="w-full glass-input px-3 py-2.5 rounded-sm text-xs text-hotel-sand font-mono"
            required
          />
        </div>

        <div>
          <label for="hero-category" class="block text-[11px] uppercase tracking-[0.2em] text-hotel-gold font-medium mb-1.5">
            Suite Category
          </label>
          <select
            id="hero-category"
            class="w-full glass-input px-3 py-2.5 rounded-sm text-xs text-hotel-sand bg-hotel-charcoal"
          >
            {
              ROOMS.map((r) => (
                <option value={r.id}>{r.name}</option>
              ))
            }
          </select>
        </div>

        <div>
          <label for="hero-guests" class="block text-[11px] uppercase tracking-[0.2em] text-hotel-gold font-medium mb-1.5">
            Guests
          </label>
          <select
            id="hero-guests"
            class="w-full glass-input px-3 py-2.5 rounded-sm text-xs text-hotel-sand bg-hotel-charcoal"
          >
            <option value="1">1 Guest</option>
            <option value="2" selected>2 Guests</option>
            <option value="3">3 Guests</option>
            <option value="4">4 Guests</option>
          </select>
        </div>

        <div>
          <button
            type="submit"
            class="w-full bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold py-3 px-4 rounded-sm transition-all duration-300 shadow-md flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Inquire Stay</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  function initHero() {
    // ---- Carousel Logic ----
    const section = document.getElementById('hero-carousel-section');
    const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
    const textItems = document.querySelectorAll<HTMLElement>('.hero-text-item');
    const indicatorBars = document.querySelectorAll<HTMLElement>('.hero-indicator-bar');
    const counterEl = document.getElementById('hero-slide-counter');
    const captionEl = document.getElementById('hero-slide-caption');
    const prevBtn = document.getElementById('hero-carousel-prev');
    const nextBtn = document.getElementById('hero-carousel-next');
    const mobilePrevBtn = document.getElementById('hero-mobile-prev');
    const mobileNextBtn = document.getElementById('hero-mobile-next');
    const indicatorBtns = document.querySelectorAll<HTMLElement>('.hero-indicator-btn');
    const autoplayToggle = document.getElementById('hero-autoplay-toggle');
    const autoplayIndicator = document.getElementById('hero-autoplay-indicator');

    if (!slides.length) return;

    const totalSlides = slides.length;
    let currentIndex = 0;
    let autoplayActive = true;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    const AUTOPLAY_INTERVAL = 6000;

    const captions = [
      'Estate Twilight Elevation',
      'Horizon Presidential Suite',
      '30m Heated Horizon Pool',
      'The Savanna Hearth',
      'Acholi Garden Villa',
      'Churchill Terrace & Bar',
    ];

    function goToSlide(targetIndex: number) {
      if (targetIndex === currentIndex) return;

      const prevIndex = currentIndex;
      currentIndex = (targetIndex + totalSlides) % totalSlides;

      // Update background slides with slow Ken Burns zoom
      slides.forEach((slide, idx) => {
        const img = slide.querySelector('.hero-slide-img') as HTMLElement | null;
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
          if (img) {
            img.classList.remove('scale-100');
            img.classList.add('scale-105');
          }
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
          if (img) {
            img.classList.remove('scale-105');
            img.classList.add('scale-100');
          }
        }
      });

      // Update foreground text with smooth staggered fade
      textItems.forEach((item, idx) => {
        if (idx === currentIndex) {
          item.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none', 'absolute');
          item.classList.add('opacity-100', 'translate-y-0', 'relative');
        } else {
          item.classList.remove('opacity-100', 'translate-y-0', 'relative');
          item.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none', 'absolute');
        }
      });

      // Update indicator progress bars
      indicatorBars.forEach((bar, idx) => {
        if (idx === currentIndex) {
          bar.classList.remove('scale-x-0');
          bar.classList.add('scale-x-100');
        } else {
          bar.classList.remove('scale-x-100');
          bar.classList.add('scale-x-0');
        }
      });

      // Update counter and caption
      if (counterEl) {
        counterEl.textContent = `0${currentIndex + 1} / 0${totalSlides}`;
      }
      if (captionEl) {
        captionEl.textContent = captions[currentIndex] || '';
      }

      // Reset autoplay timer on manual slide change
      if (autoplayActive) {
        startAutoplay();
      }
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        nextSlide();
      }, AUTOPLAY_INTERVAL);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Button event listeners
    nextBtn?.addEventListener('click', nextSlide);
    prevBtn?.addEventListener('click', prevSlide);
    mobileNextBtn?.addEventListener('click', nextSlide);
    mobilePrevBtn?.addEventListener('click', prevSlide);

    indicatorBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-indicator-index') || '0', 10);
        goToSlide(idx);
      });
    });

    autoplayToggle?.addEventListener('click', () => {
      autoplayActive = !autoplayActive;
      if (autoplayActive) {
        startAutoplay();
        if (autoplayIndicator) autoplayIndicator.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
      } else {
        stopAutoplay();
        if (autoplayIndicator) autoplayIndicator.className = 'w-1.5 h-1.5 rounded-full bg-amber-400';
      }
    });

    // Pause autoplay on mouse hover (desktop)
    section?.addEventListener('mouseenter', () => {
      if (autoplayActive) stopAutoplay();
    });
    section?.addEventListener('mouseleave', () => {
      if (autoplayActive) startAutoplay();
    });

    // Mobile touch / swipe gestures
    let touchStartX = 0;
    let touchStartY = 0;

    section?.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      },
      { passive: true }
    );

    section?.addEventListener(
      'touchend',
      (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const deltaX = touchEndX - touchStartX;
        const deltaY = touchEndY - touchStartY;

        // Check if horizontal swipe is prominent enough
        if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY)) {
          if (deltaX < 0) {
            nextSlide();
          } else {
            prevSlide();
          }
        }
      },
      { passive: true }
    );

    // Keyboard navigation when user presses left/right arrow keys
    window.addEventListener('keydown', (e) => {
      const activeEl = document.activeElement;
      const isInput = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'SELECT' || activeEl.tagName === 'TEXTAREA');
      if (isInput) return;

      if (e.key === 'ArrowRight') {
        nextSlide();
      } else if (e.key === 'ArrowLeft') {
        prevSlide();
      }
    });

    // Start initial autoplay
    if (autoplayActive) {
      startAutoplay();
    }

    // ---- Quick Booking Search Bar Logic ----
    const heroForm = document.getElementById('hero-quick-book');
    const heroIn = document.getElementById('hero-checkin') as HTMLInputElement;
    const heroOut = document.getElementById('hero-checkout') as HTMLInputElement;
    const heroCat = document.getElementById('hero-category') as HTMLSelectElement;

    const now = new Date();
    const nextDay = new Date(now);
    nextDay.setDate(nextDay.getDate() + 1);
    const nextThreeDays = new Date(now);
    nextThreeDays.setDate(nextThreeDays.getDate() + 4);

    if (heroIn && heroOut && !heroIn.value) {
      heroIn.min = nextDay.toISOString().split('T')[0];
      heroIn.value = nextDay.toISOString().split('T')[0];
      heroOut.min = nextThreeDays.toISOString().split('T')[0];
      heroOut.value = nextThreeDays.toISOString().split('T')[0];
    }

    heroForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const selectedRoom = heroCat?.value;
      if (typeof (window as any).__openBookingModal === 'function') {
        (window as any).__openBookingModal(selectedRoom || undefined);
      } else {
        const modalTrigger = document.querySelector('[data-open-reserve-modal]') as HTMLElement;
        if (modalTrigger) {
          modalTrigger.setAttribute('data-room-id', selectedRoom || '');
          modalTrigger.click();
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initHero);
</script>
