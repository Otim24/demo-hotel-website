---
import { HOTEL_INFO } from '../data/hotelData';
---

<footer class="relative bg-hotel-dark text-hotel-sand border-t border-hotel-border/40 overflow-hidden pt-20 pb-12">
  <!-- Subtle top glow -->
  <div class="ambient-glow top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-15"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    <!-- Top Row: Newsletter & Private Folio Subscription -->
    <div class="glass-panel p-8 sm:p-12 rounded-lg border border-hotel-border/40 mb-16 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="max-w-xl text-center lg:text-left">
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold block mb-2">
          The Northern Private Dispatch
        </span>
        <h3 class="font-serif text-2xl sm:text-3xl text-hotel-sand-light tracking-wide mb-2">
          Receive Private Safari Clearances & Seasonal Folios
        </h3>
        <p class="text-xs sm:text-sm text-hotel-muted font-light leading-relaxed">
          Dispatched quad-annually with exclusive seasonal dining programs, private aircraft schedules, and astronomy calendars.
        </p>
      </div>

      <form id="newsletter-form" class="w-full lg:w-auto flex flex-col sm:flex-row items-stretch gap-3">
        <input
          type="email"
          placeholder="Enter your executive email"
          required
          class="glass-input px-5 py-3 rounded-sm text-xs text-hotel-sand min-w-[280px] focus:ring-1 focus:ring-hotel-gold"
        />
        <button
          type="submit"
          class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold px-6 py-3 rounded-sm transition-colors shadow-md whitespace-nowrap"
        >
          Subscribe
        </button>
      </form>
    </div>

    <!-- Main Navigation Columns -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 pb-16 border-b border-white/10">
      <!-- Col 1: Brand & Identity -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-sm border border-hotel-gold/40 flex items-center justify-center bg-hotel-charcoal">
            <svg class="w-4 h-4 text-hotel-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div>
            <span class="font-display tracking-[0.25em] text-lg font-semibold text-hotel-sand-light uppercase block">
              The Northern
            </span>
            <span class="text-[10px] tracking-[0.25em] uppercase text-hotel-gold font-medium">
              Grand Hotel & Safari Sanctuary
            </span>
          </div>
        </div>

        <p class="text-xs text-hotel-muted font-light leading-relaxed max-w-sm pt-2">
          An architectural retreat in Gulu, Northern Uganda, providing refined luxury, discreet security, and bespoke wilderness expeditions to the northern savannas.
        </p>

        <div class="pt-2 text-xs font-mono text-hotel-gold/80">
          GPS: {HOTEL_INFO.location.coordinates}
        </div>
      </div>

      <!-- Col 2: Accommodations -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] text-hotel-gold font-semibold mb-4">
          Residences
        </h4>
        <ul class="space-y-2.5 text-xs text-hotel-muted">
          <li><a href="/rooms#savanna-presidential-sanctuary" class="hover:text-hotel-sand transition-colors">Presidential Sanctuary</a></li>
          <li><a href="/rooms#acholi-heritage-villa" class="hover:text-hotel-sand transition-colors">Acholi Heritage Villa</a></li>
          <li><a href="/rooms#executive-horizon-suite" class="hover:text-hotel-sand transition-colors">Executive Horizon Suite</a></li>
          <li><a href="/rooms#terrace-deluxe-room" class="hover:text-hotel-sand transition-colors">Terrace Deluxe Room</a></li>
          <li><a href="/reserve" class="text-hotel-gold hover:text-hotel-sand transition-colors font-medium">Check Live Availability</a></li>
        </ul>
      </div>

      <!-- Col 3: Experiences & Dining -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] text-hotel-gold font-semibold mb-4">
          Experiences
        </h4>
        <ul class="space-y-2.5 text-xs text-hotel-muted">
          <li><a href="/dining" class="hover:text-hotel-sand transition-colors">The Savanna Hearth</a></li>
          <li><a href="/dining" class="hover:text-hotel-sand transition-colors">Churchill Terrace Bar</a></li>
          <li><a href="/experiences" class="hover:text-hotel-sand transition-colors">Kidepo Valley Fly-In</a></li>
          <li><a href="/experiences" class="hover:text-hotel-sand transition-colors">Aruu Cascades Trek</a></li>
          <li><a href="/events" class="hover:text-hotel-sand transition-colors">The Karuma Ballroom</a></li>
        </ul>
      </div>

      <!-- Col 4: Concierge & Reservations -->
      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] text-hotel-gold font-semibold mb-4">
          Direct Concierge
        </h4>
        <div class="space-y-3 text-xs text-hotel-muted">
          <div>
            <div class="text-[10px] uppercase text-hotel-gold/80 font-mono">Reservations</div>
            <a href="tel:+256471432900" class="hover:text-hotel-sand transition-colors font-mono">
              +256 471 432 900
            </a>
          </div>
          <div>
            <div class="text-[10px] uppercase text-hotel-gold/80 font-mono">Concierge Desk</div>
            <a href="tel:+256782110404" class="hover:text-hotel-sand transition-colors font-mono">
              +256 782 110 404
            </a>
          </div>
          <div>
            <div class="text-[10px] uppercase text-hotel-gold/80 font-mono">General Enquiries</div>
            <a href="mailto:reservations@thenorthern-hotel.com" class="hover:text-hotel-sand transition-colors">
              reservations@thenorthern-hotel.com
            </a>
          </div>
          <div>
            <div class="text-[10px] uppercase text-hotel-gold/80 font-mono">Location</div>
            <span class="text-hotel-sand/80">Plot 14 Churchill Way, Gulu Central, Uganda</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Discretion Notice -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-hotel-muted gap-4">
      <div class="flex items-center gap-6">
        <span>&copy; {new Date().getFullYear()} The Northern Grand Hotel. All rights reserved.</span>
        <span class="hidden md:inline text-white/20">|</span>
        <span class="hidden md:inline">Northern Uganda Luxury Sanctuary</span>
      </div>

      <div class="flex items-center gap-6">
        <a href="/contact" class="hover:text-hotel-gold transition-colors">Security Protocol</a>
        <a href="/contact" class="hover:text-hotel-gold transition-colors">Privacy Folio</a>
        <a href="/contact" class="hover:text-hotel-gold transition-colors">Helipad Access</a>
      </div>
    </div>
  </div>
</footer>
