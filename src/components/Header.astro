---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Rooms', href: '/rooms' },
  { name: 'Dining', href: '/dining' },
  { name: 'Amenities', href: '/amenities' },
  { name: 'Events', href: '/events' },
  { name: 'Location', href: '/contact' },
];
---

<!-- Fixed Header Container (Always visible, perfectly positioned) -->
<header id="main-header" class="fixed top-0 left-0 right-0 z-40 w-full transition-all duration-300">
  <!-- Top Demo Purpose Utility Ribbon (Integrated in header, never overlaps) -->
  <aside class="bg-hotel-dark/95 border-b border-hotel-gold/20 py-1.5 px-4 text-center backdrop-blur-md" aria-label="Demo Disclaimer">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 text-[10px] sm:text-[11px] uppercase tracking-[0.18em] text-hotel-sand/90 font-medium">
      <span class="w-1.5 h-1.5 rounded-full bg-hotel-gold animate-pulse"></span>
      <span>Demonstration Prototype: Created for presentation & design evaluation purposes</span>
    </div>
  </aside>

  <!-- Main Navigation Bar -->
  <div id="navbar-inner" class="glass-panel-heavy border-b border-white/5 py-3 px-4 sm:px-6 lg:px-12 transition-all duration-300">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
      <!-- Brand Crest & Logo -->
      <a href="/" class="group flex items-center gap-2.5 sm:gap-3 focus:outline-none rounded-sm flex-shrink-0">
        <div class="w-9 h-9 rounded-sm border border-hotel-gold/40 flex items-center justify-center bg-hotel-charcoal/80 backdrop-blur-sm group-hover:border-hotel-gold transition-colors duration-300">
          <svg class="w-4 h-4 text-hotel-gold transition-transform duration-500 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-display tracking-[0.2em] text-base sm:text-lg font-semibold text-hotel-sand-light uppercase group-hover:text-hotel-gold transition-colors duration-300 leading-tight">
            The Northern
          </span>
          <span class="font-sans text-[9px] tracking-[0.25em] uppercase text-hotel-gold/80 font-medium">
            Grand Hotel, Gulu
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links with Hover Animation -->
      <nav class="hidden md:flex items-center gap-1 xl:gap-2 glass-panel px-4 py-1.5 rounded-full shadow-lg border border-hotel-border/50">
        {
          navLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                href={link.href}
                class={`nav-anim-link group relative px-4 py-2 text-xs uppercase tracking-[0.15em] font-medium transition-all duration-300 rounded-full flex flex-col items-center justify-center ${
                  isActive
                    ? 'text-hotel-gold bg-hotel-gold/10 font-semibold'
                    : 'text-hotel-sand/85 hover:text-hotel-gold-light'
                }`}
              >
                <!-- Animated Text with Lift -->
                <span class="relative z-10 transition-transform duration-300 ease-out group-hover:-translate-y-0.5">
                  {link.name}
                </span>

                <!-- Hover Glow Pill -->
                <span class="absolute inset-0 rounded-full bg-gradient-to-r from-hotel-gold/0 via-hotel-gold/15 to-hotel-gold/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></span>

                <!-- Animated Expanding Golden Underline -->
                <span
                  class={`absolute bottom-1 w-5 h-[1.5px] bg-hotel-gold rounded-full transition-all duration-300 ease-out ${
                    isActive
                      ? 'opacity-100 scale-x-100'
                      : 'opacity-0 scale-x-0 group-hover:opacity-100 group-hover:scale-x-100'
                  }`}
                ></span>
              </a>
            );
          })
        }
      </nav>

      <!-- Desktop Reservation CTA & Contact -->
      <div class="hidden md:flex items-center gap-3 flex-shrink-0">
        <a
          href="tel:+256784811929"
          class="text-xs tracking-wider text-hotel-sand/70 hover:text-hotel-gold transition-colors py-2 px-2.5 flex items-center gap-2"
          aria-label="Direct Phone Reservation"
        >
          <svg class="w-3.5 h-3.5 text-hotel-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="font-mono text-[11px] hidden xl:inline">+256 784 811 929</span>
        </a>

        <button
          type="button"
          data-open-reserve-modal
          class="relative overflow-hidden group border border-hotel-gold/70 bg-gradient-to-r from-hotel-gold/90 to-hotel-gold-dark text-hotel-dark font-sans text-xs tracking-[0.18em] uppercase font-semibold px-5 py-2.5 rounded-sm transition-all duration-300 hover:shadow-[0_0_20px_rgba(197,160,89,0.35)] hover:border-hotel-gold"
        >
          <span class="relative z-10">Reserve</span>
          <div class="absolute inset-0 bg-hotel-sand-light transform -translate-x-full group-hover:translate-x-0 transition-transform duration-300 opacity-20"></div>
        </button>
      </div>

      <!-- Mobile Navigation Actions (Always fully visible and tap-optimized) -->
      <div class="flex items-center gap-2 md:hidden flex-shrink-0">
        <button
          type="button"
          data-open-reserve-modal
          class="text-[10px] uppercase tracking-wider font-semibold text-hotel-dark bg-hotel-gold px-3 py-2 rounded-sm active:scale-95 transition-transform"
        >
          Reserve
        </button>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="w-11 h-11 rounded-sm border border-hotel-gold/50 bg-hotel-charcoal flex flex-col items-center justify-center gap-1.5 text-hotel-gold active:bg-hotel-elevated transition-colors focus:outline-none touch-manipulation cursor-pointer shadow-md"
          aria-label="Open Navigation Menu"
          aria-expanded="false"
        >
          <span class="w-5 h-[2px] bg-hotel-gold rounded-full pointer-events-none"></span>
          <span class="w-5 h-[2px] bg-hotel-gold rounded-full pointer-events-none"></span>
          <span class="w-5 h-[2px] bg-hotel-gold rounded-full pointer-events-none"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Fullscreen Mobile Navigation Drawer (Top layer z-[100]) -->
<div
  id="mobile-nav-drawer"
  class="fixed inset-0 z-[100] pointer-events-none opacity-0 transition-opacity duration-300 flex flex-col"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <!-- Backdrop Blur Overlay -->
  <div
    id="mobile-nav-backdrop"
    class="absolute inset-0 bg-hotel-dark/95 backdrop-blur-2xl"
  ></div>

  <!-- Drawer Content Panel -->
  <div
    id="mobile-nav-panel"
    class="relative z-10 w-full h-full flex flex-col justify-between p-6 sm:p-8 transform -translate-y-4 transition-transform duration-300 overflow-y-auto"
  >
    <!-- Top Bar inside Drawer -->
    <div class="flex items-center justify-between border-b border-hotel-border/40 pb-4">
      <div class="flex flex-col">
        <span class="font-display tracking-[0.22em] text-lg font-semibold text-hotel-sand-light uppercase leading-tight">
          The Northern
        </span>
        <span class="font-sans text-[10px] tracking-[0.25em] uppercase text-hotel-gold">
          Grand Hotel, Gulu
        </span>
      </div>

      <button
        id="mobile-menu-close"
        type="button"
        class="w-11 h-11 rounded-sm border border-hotel-gold/50 bg-hotel-charcoal/80 flex items-center justify-center text-hotel-sand active:text-hotel-gold active:border-hotel-gold transition-colors focus:outline-none cursor-pointer touch-manipulation"
        aria-label="Close Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Links in Mobile Menu -->
    <div class="py-6 flex flex-col gap-3">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] uppercase tracking-[0.25em] text-hotel-gold font-semibold">
          Hotel Navigation
        </span>
        <span class="text-[10px] font-mono text-hotel-muted">DEMO CONCEPT</span>
      </div>
      {
        navLinks.map((link, idx) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`mobile-nav-link text-2xl font-serif tracking-wide transition-all duration-200 flex items-center justify-between border-b border-white/5 py-3 ${
                isActive ? 'text-hotel-gold pl-2 font-medium' : 'text-hotel-sand/90 hover:text-hotel-gold'
              }`}
            >
              <span>{link.name}</span>
              <span class="font-mono text-xs text-hotel-gold/50">0{idx + 1}</span>
            </a>
          );
        })
      }
      <a
        href="/reserve"
        class="mobile-nav-link text-2xl font-serif tracking-wide text-hotel-gold-light border-b border-white/5 py-3 flex items-center justify-between"
      >
        <span>Direct Reservations</span>
        <span class="font-mono text-xs text-hotel-gold">06</span>
      </a>
    </div>

    <!-- Bottom Contact & Details in Mobile Menu -->
    <div class="border-t border-hotel-border/40 pt-5 flex flex-col gap-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <div class="text-[10px] uppercase tracking-[0.18em] text-hotel-muted">Direct Reservations</div>
          <a href="tel:+256784811929" class="text-sm font-mono text-hotel-sand hover:text-hotel-gold transition-colors">
            +256 784 811 929
          </a>
        </div>
        <div>
          <div class="text-[10px] uppercase tracking-[0.18em] text-hotel-muted">Concierge Desk</div>
          <a href="mailto:concierge@thenorthern-hotel.com" class="text-xs font-sans text-hotel-sand hover:text-hotel-gold transition-colors">
            concierge@thenorthern-hotel.com
          </a>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <span class="text-[11px] text-hotel-muted font-sans">
          Plot 14 Churchill Way, Gulu Central
        </span>
        <button
          type="button"
          data-open-reserve-modal
          class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.18em] uppercase font-semibold px-5 py-2.5 rounded-sm transition-colors cursor-pointer"
        >
          Book Stay
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Mobile drawer management
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-nav-drawer');
  const panel = document.getElementById('mobile-nav-panel');

  function openDrawer(e?: Event) {
    if (e) e.preventDefault();
    if (!drawer || !panel) return;

    drawer.classList.remove('pointer-events-none', 'opacity-0');
    drawer.classList.add('pointer-events-auto', 'opacity-100');
    drawer.setAttribute('aria-hidden', 'false');
    toggleBtn?.setAttribute('aria-expanded', 'true');

    panel.classList.remove('-translate-y-4');
    panel.classList.add('translate-y-0');

    document.body.style.overflow = 'hidden';
  }

  function closeDrawer(e?: Event) {
    if (e) e.preventDefault();
    if (!drawer || !panel) return;

    panel.classList.remove('translate-y-0');
    panel.classList.add('-translate-y-4');

    drawer.classList.remove('opacity-100');
    drawer.classList.add('opacity-0');

    setTimeout(() => {
      drawer.classList.remove('pointer-events-auto');
      drawer.classList.add('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }, 280);
  }

  toggleBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);

  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
  mobileNavLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeDrawer();
    });
  });
</script>
