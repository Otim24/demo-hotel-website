---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Accommodations', href: '/rooms' },
  { name: 'Dining & Lounge', href: '/dining' },
  { name: 'Safari & Excursions', href: '/experiences' },
  { name: 'Gatherings & Events', href: '/events' },
  { name: 'Location & Concierge', href: '/contact' },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-500 py-5 px-4 md:px-8 lg:px-12">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Crest & Logo -->
    <a href="/" class="group flex items-center gap-3.5 focus:outline-none focus:ring-1 focus:ring-hotel-gold/50 rounded-sm">
      <div class="w-10 h-10 rounded-sm border border-hotel-gold/40 flex items-center justify-center bg-hotel-charcoal/60 backdrop-blur-sm group-hover:border-hotel-gold transition-colors duration-300">
        <svg class="w-5 h-5 text-hotel-gold transition-transform duration-500 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-display tracking-[0.25em] text-lg sm:text-xl font-semibold text-hotel-sand-light uppercase group-hover:text-hotel-gold transition-colors duration-300">
          The Northern
        </span>
        <span class="font-sans text-[10px] tracking-[0.3em] uppercase text-hotel-gold/80 font-medium">
          Grand Hotel & Safari
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-8 xl:gap-10 glass-panel px-7 py-2.5 rounded-full shadow-lg">
      {
        navLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`text-xs uppercase tracking-[0.18em] transition-all duration-300 py-1 relative font-medium ${
                isActive
                  ? 'text-hotel-gold font-semibold'
                  : 'text-hotel-sand/85 hover:text-hotel-gold'
              }`}
            >
              {link.name}
              {isActive && (
                <span class="absolute -bottom-1 left-0 right-0 h-[1.5px] bg-hotel-gold rounded-full" />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Desktop Reservation CTA & Contact -->
    <div class="hidden lg:flex items-center gap-4">
      <a
        href="tel:+256471432900"
        class="text-xs tracking-wider text-hotel-sand/70 hover:text-hotel-gold transition-colors py-2 px-3 flex items-center gap-2"
        aria-label="Direct Phone Reservation"
      >
        <svg class="w-3.5 h-3.5 text-hotel-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="font-mono text-[11px]">+256 471 432 900</span>
      </a>

      <button
        type="button"
        data-open-reserve-modal
        class="relative overflow-hidden group border border-hotel-gold/70 bg-gradient-to-r from-hotel-gold/90 to-hotel-gold-dark text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold px-6 py-2.5 rounded-sm transition-all duration-300 hover:shadow-[0_0_20px_rgba(197,160,89,0.35)] hover:border-hotel-gold"
      >
        <span class="relative z-10">Reserve Stay</span>
        <div class="absolute inset-0 bg-hotel-sand-light transform -translate-x-full group-hover:translate-x-0 transition-transform duration-300 opacity-20"></div>
      </button>
    </div>

    <!-- Mobile Hamburger Toggle Button -->
    <div class="flex items-center gap-3 lg:hidden">
      <button
        type="button"
        data-open-reserve-modal
        class="text-[11px] uppercase tracking-wider font-semibold text-hotel-dark bg-hotel-gold px-3.5 py-1.5 rounded-sm"
      >
        Reserve
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="w-11 h-11 rounded-sm border border-hotel-gold/30 bg-hotel-charcoal/80 backdrop-blur-md flex flex-col items-center justify-center gap-1.5 text-hotel-sand transition-colors hover:border-hotel-gold focus:outline-none"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <span id="burger-bar-1" class="w-5 h-[1.5px] bg-hotel-sand transition-all duration-300"></span>
        <span id="burger-bar-2" class="w-5 h-[1.5px] bg-hotel-sand transition-all duration-300"></span>
        <span id="burger-bar-3" class="w-3.5 h-[1.5px] bg-hotel-gold self-start ml-3 transition-all duration-300"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div
  id="mobile-nav-drawer"
  class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-all duration-500 flex flex-col"
  aria-hidden="true"
>
  <!-- Backdrop Blur Overlay -->
  <div
    id="mobile-nav-backdrop"
    class="absolute inset-0 bg-hotel-dark/95 backdrop-blur-2xl transition-opacity duration-500 opacity-0"
  ></div>

  <!-- Drawer Content Container -->
  <div
    id="mobile-nav-panel"
    class="relative z-10 w-full h-full flex flex-col justify-between p-6 sm:p-10 transform translate-y-6 transition-transform duration-500 overflow-y-auto"
  >
    <!-- Top Bar inside Drawer -->
    <div class="flex items-center justify-between border-b border-hotel-border/40 pb-5">
      <div class="flex flex-col">
        <span class="font-display tracking-[0.25em] text-lg font-semibold text-hotel-sand-light uppercase">
          The Northern
        </span>
        <span class="font-sans text-[10px] tracking-[0.25em] uppercase text-hotel-gold">
          Grand Hotel & Safari Sanctuary
        </span>
      </div>

      <button
        id="mobile-menu-close"
        type="button"
        class="w-10 h-10 rounded-sm border border-hotel-gold/40 flex items-center justify-center text-hotel-sand hover:text-hotel-gold hover:border-hotel-gold transition-colors focus:outline-none"
        aria-label="Close Navigation Menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <div class="py-8 flex flex-col gap-6">
      <p class="text-[11px] uppercase tracking-[0.3em] text-hotel-gold/75 font-semibold">
        Explore The Sanctuary
      </p>
      {
        navLinks.map((link, idx) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`mobile-nav-link text-2xl sm:text-3xl font-serif tracking-wide transition-all duration-300 flex items-center justify-between border-b border-white/5 pb-4 ${
                isActive ? 'text-hotel-gold pl-2 font-medium' : 'text-hotel-sand/90 hover:text-hotel-gold hover:pl-2'
              }`}
            >
              <span>{link.name}</span>
              <span class="font-mono text-xs text-hotel-gold/50">0{idx + 1}</span>
            </a>
          );
        })
      }
      <a
        href="/reserve"
        class="mobile-nav-link text-2xl sm:text-3xl font-serif tracking-wide text-hotel-gold-light border-b border-white/5 pb-4 flex items-center justify-between"
      >
        <span>Direct Reservations</span>
        <span class="font-mono text-xs text-hotel-gold">06</span>
      </a>
    </div>

    <!-- Bottom Contact & Details in Mobile Menu -->
    <div class="border-t border-hotel-border/40 pt-6 flex flex-col gap-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-hotel-muted">Direct Reservations</div>
          <a href="tel:+256471432900" class="text-sm font-mono text-hotel-sand hover:text-hotel-gold transition-colors">
            +256 471 432 900
          </a>
        </div>
        <div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-hotel-muted">Concierge Desk</div>
          <a href="mailto:concierge@thenorthern-hotel.com" class="text-sm font-sans text-hotel-sand hover:text-hotel-gold transition-colors">
            concierge@thenorthern-hotel.com
          </a>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <span class="text-xs text-hotel-muted/80 font-sans">
          Plot 14 Churchill Way, Gulu Central, Uganda
        </span>
        <button
          type="button"
          data-open-reserve-modal
          class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold px-5 py-2.5 rounded-sm transition-colors"
        >
          Check Availability
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Dynamic header blur on scroll
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header?.classList.add('glass-panel-heavy', 'shadow-2xl', 'py-3.5');
      header?.classList.remove('py-5');
    } else {
      header?.classList.remove('glass-panel-heavy', 'shadow-2xl', 'py-3.5');
      header?.classList.add('py-5');
    }
  });

  // Mobile menu toggle handling
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-nav-drawer');
  const backdrop = document.getElementById('mobile-nav-backdrop');
  const panel = document.getElementById('mobile-nav-panel');

  const bar1 = document.getElementById('burger-bar-1');
  const bar2 = document.getElementById('burger-bar-2');
  const bar3 = document.getElementById('burger-bar-3');

  function openMenu() {
    if (!drawer || !backdrop || !panel) return;
    drawer.classList.remove('pointer-events-none', 'opacity-0');
    drawer.classList.add('pointer-events-auto', 'opacity-100');
    drawer.setAttribute('aria-hidden', 'false');
    toggleBtn?.setAttribute('aria-expanded', 'true');

    backdrop.classList.remove('opacity-0');
    backdrop.classList.add('opacity-100');

    panel.classList.remove('translate-y-6');
    panel.classList.add('translate-y-0');

    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!drawer || !backdrop || !panel) return;
    drawer.classList.add('opacity-0');
    drawer.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    backdrop.classList.remove('opacity-100');
    panel.classList.add('translate-y-6');
    panel.classList.remove('translate-y-0');

    setTimeout(() => {
      drawer.classList.add('pointer-events-none');
      drawer.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }, 400);
  }

  toggleBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  // Close menu on link click
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
