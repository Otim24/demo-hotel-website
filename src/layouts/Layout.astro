---
import { ClientRouter, fade } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
import FloorplanModal from '../components/FloorplanModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'The Northern | Grand Hotel, Gulu, Uganda',
  description = 'A distinguished luxury hotel in Northern Uganda offering executive suites, fine dining at The Hearth, wellness spa, and state-of-the-art conference facilities.',
  currentPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e0c" />

    <!-- Seamless Client-Side Router for Silky Smooth Page Transitions -->
    <ClientRouter />

    <!-- Open Graph / Social Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Hotel Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Hotel",
        "name": "The Northern Grand Hotel",
        "description": "Luxury hotel sanctuary in Northern Uganda featuring executive suites, fine dining, wellness spa, and conference ballrooms.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Plot 14 Churchill Way",
          "addressLocality": "Gulu",
          "addressRegion": "Northern Province",
          "addressCountry": "UG"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "2.7746",
          "longitude": "32.2990"
        },
        "telephone": "+256 784 811 929",
        "priceRange": "$$$$"
      }
    </script>
  </head>
  <body class="bg-hotel-dark text-hotel-sand selection:bg-hotel-gold/30 selection:text-white flex flex-col min-h-screen">
    <!-- Header with dynamic blur and smooth mobile drawer -->
    <Header currentPath={currentPath} transition:persist="site-header" />

    <!-- Main Content with Silky Smooth Fade Transition -->
    <main class="flex-grow" transition:animate={fade({ duration: '0.36s' })}>
      <slot />
    </main>

    <!-- Footer -->
    <Footer transition:persist="site-footer" />

    <!-- Global Reservation Engine Modal -->
    <BookingModal transition:persist="booking-modal" />

    <!-- Floorplan & Spatial Configuration Modal -->
    <FloorplanModal transition:persist="floorplan-modal" />

    <!-- Scroll Reconstruct / Deconstruct Kinetic Engine on Page Load -->
    <script>
      function initKineticScroll() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const kineticElements = document.querySelectorAll<HTMLElement>(
          '.kinetic-deconstruct, .kinetic-block, .kinetic-card, .kinetic-left, .kinetic-right, .reveal-init'
        );

        if (!kineticElements.length) return;

        if (prefersReducedMotion) {
          kineticElements.forEach((el) => {
            el.classList.add('is-constructed', 'reveal-visible');
          });
          return;
        }

        const observerOptions: IntersectionObserverInit = {
          root: null,
          rootMargin: '-3% 0px -3% 0px',
          threshold: [0, 0.08, 0.2],
        };

        const observerCallback: IntersectionObserverCallback = (entries) => {
          entries.forEach((entry) => {
            const target = entry.target as HTMLElement;

            if (entry.isIntersecting && entry.intersectionRatio > 0.03) {
              // RECONSTRUCT: Smoothly assemble as visitor scrolls into view
              target.classList.remove('is-deconstructed-up', 'is-deconstructed-down');
              target.classList.add('is-constructed', 'reveal-visible');
            } else if (!entry.isIntersecting) {
              // DECONSTRUCT: Smoothly dissolve and separate as visitor scrolls away
              target.classList.remove('is-constructed', 'reveal-visible');
              const rect = entry.boundingClientRect;
              if (rect.top < 0) {
                // Scrolled past the top
                target.classList.add('is-deconstructed-up');
                target.classList.remove('is-deconstructed-down');
              } else {
                // Scrolled away past the bottom
                target.classList.add('is-deconstructed-down');
                target.classList.remove('is-deconstructed-up');
              }
            }
          });
        };

        const observer = new IntersectionObserver(observerCallback, observerOptions);
        kineticElements.forEach((el) => {
          observer.observe(el);
        });
      }

      // Run on initial load and on every client navigation
      document.addEventListener('astro:page-load', initKineticScroll);
    </script>
  </body>
</html>

