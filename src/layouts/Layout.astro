---
import { ClientRouter, fade } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
import FloorplanModal from '../components/FloorplanModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'The Northern | Grand Hotel, Gulu, Uganda',
  description = 'A distinguished luxury hotel in Northern Uganda offering executive suites, fine dining at The Hearth, wellness spa, and state-of-the-art conference facilities.',
  currentPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e0c" />

    <!-- Seamless Client-Side Router for Silky Smooth Page Transitions -->
    <ClientRouter />

    <!-- Open Graph / Social Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Hotel Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Hotel",
        "name": "The Northern Grand Hotel",
        "description": "Luxury hotel sanctuary in Northern Uganda featuring executive suites, fine dining, wellness spa, and conference ballrooms.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Plot 14 Churchill Way",
          "addressLocality": "Gulu",
          "addressRegion": "Northern Province",
          "addressCountry": "UG"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "2.7746",
          "longitude": "32.2990"
        },
        "telephone": "+256 784 811 929",
        "priceRange": "$$$$"
      }
    </script>
  </head>
  <body class="bg-hotel-dark text-hotel-sand selection:bg-hotel-gold/30 selection:text-white flex flex-col min-h-screen">
    <!-- Header with dynamic blur and smooth mobile drawer -->
    <Header currentPath={currentPath} transition:persist="site-header" />

    <!-- Main Content with Silky Smooth Fade Transition -->
    <main class="flex-grow" transition:animate={fade({ duration: '0.36s' })}>
      <slot />
    </main>

    <!-- Footer -->
    <Footer transition:persist="site-footer" />

    <!-- Global Reservation Engine Modal -->
    <BookingModal transition:persist="booking-modal" />

    <!-- Floorplan & Spatial Configuration Modal -->
    <FloorplanModal transition:persist="floorplan-modal" />

    <!-- Scroll Reconstruct / Deconstruct Kinetic Engine on Page Load -->
    <script>
      let scrollListener: (() => void) | null = null;
      let resizeListener: (() => void) | null = null;

      function initKineticScroll() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const kineticElements = document.querySelectorAll<HTMLElement>(
          '.kinetic-deconstruct, .kinetic-block, .kinetic-card, .kinetic-left, .kinetic-right, .kinetic-spread, .reveal-init'
        );

        if (!kineticElements.length) return;

        if (prefersReducedMotion) {
          kineticElements.forEach((el) => {
            el.classList.add('is-constructed');
            el.classList.remove('is-deconstructing-top', 'is-deconstructed-up', 'is-deconstructed-down');
          });
          return;
        }

        // Clean up previous listeners if attached
        if (scrollListener) window.removeEventListener('scroll', scrollListener);
        if (resizeListener) window.removeEventListener('resize', resizeListener);

        let ticking = false;

        function evaluateKineticPositions() {
          const vh = window.innerHeight || document.documentElement.clientHeight;

          kineticElements.forEach((el) => {
            const rect = el.getBoundingClientRect();

            // 1. Completely off-screen past the top
            if (rect.bottom <= 0) {
              el.classList.remove('is-constructed', 'is-deconstructing-top', 'is-deconstructed-down');
              el.classList.add('is-deconstructed-up');
            }
            // 2. Actively deconstructing in upper 24% of the viewport (clearly visible as scrolling away)
            else if (rect.bottom < vh * 0.24 || (rect.top < 0 && rect.bottom < vh * 0.5)) {
              el.classList.remove('is-constructed', 'is-deconstructed-up', 'is-deconstructed-down');
              el.classList.add('is-deconstructing-top');
            }
            // 3. Completely off-screen below the viewport
            else if (rect.top >= vh) {
              el.classList.remove('is-constructed', 'is-deconstructing-top', 'is-deconstructed-up');
              el.classList.add('is-deconstructed-down');
            }
            // 4. Emerging from below viewport threshold
            else if (rect.top > vh * 0.90) {
              el.classList.remove('is-constructed', 'is-deconstructing-top', 'is-deconstructed-up');
              el.classList.add('is-deconstructed-down');
            }
            // 5. Active focus viewport zone: fully reconstructed, crystal clear, sharp
            else {
              el.classList.remove('is-deconstructing-top', 'is-deconstructed-up', 'is-deconstructed-down');
              el.classList.add('is-constructed');
            }
          });

          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(evaluateKineticPositions);
            ticking = true;
          }
        }

        scrollListener = onScroll;
        resizeListener = onScroll;

        // Run immediately to construct visible elements
        evaluateKineticPositions();

        window.addEventListener('scroll', scrollListener, { passive: true });
        window.addEventListener('resize', resizeListener, { passive: true });
      }

      // Run on initial load and on every client navigation
      document.addEventListener('astro:page-load', initKineticScroll);
    </script>
  </body>
</html>

