---
import Layout from '../layouts/Layout.astro';
import { HOTEL_INFO } from '../data/hotelData';
---

<Layout
  title="Location & Concierge | The Northern Grand Hotel, Gulu"
  description="Contact our 24-hour concierge desk, view driving and flight routes, or locate The Northern on our interactive map in Gulu Central, Northern Uganda."
  currentPath="/contact"
>
  <!-- Page Header -->
  <section class="relative pt-36 pb-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2200&q=80"
        alt="The Northern Estate Entrance"
        class="w-full h-full object-cover filter brightness-[0.38] contrast-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/60 to-hotel-dark/80"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 glass-panel px-4 py-1.5 rounded-full mb-4 border border-hotel-gold/30">
        <span class="w-1.5 h-1.5 rounded-full bg-hotel-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold">Location & Concierge Desk</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-hotel-sand-light tracking-tight mb-4">
        Contact & Arrival Coordinates
      </h1>
      <p class="text-xs sm:text-base text-hotel-sand/90 font-light leading-relaxed max-w-2xl mx-auto">
        Plot 14 Churchill Way, Gulu Central, Northern Uganda. Our dedicated concierge team is at your disposal 24 hours a day to assist with air charters, private road transfers, and reservations.
      </p>
    </div>
  </section>

  <!-- Interactive Google Map Section with Architectural Backdrop -->
  <section class="py-16 px-4 sm:px-6 lg:px-12 bg-hotel-dark relative overflow-hidden">
    <!-- Atmospheric architectural background layer -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=2200&q=80"
        alt="Stone Texture Backdrop"
        class="w-full h-full object-cover opacity-10 filter brightness-40 contrast-125"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-hotel-dark via-hotel-dark/90 to-hotel-dark"></div>
      <div class="ambient-glow top-1/2 left-0 opacity-20"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="glass-panel p-4 sm:p-8 rounded-xl border border-hotel-border/40 space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-white/10 pb-4">
          <div>
            <span class="text-[10px] uppercase font-mono tracking-widest text-hotel-gold block">Property Location</span>
            <h2 class="font-serif text-2xl text-hotel-sand-light">{HOTEL_INFO.location.address}</h2>
          </div>
          <div class="flex items-center gap-4">
            <span class="font-mono text-xs text-hotel-gold glass-panel px-3 py-1.5 rounded-sm">
              {HOTEL_INFO.location.coordinates}
            </span>
            <a
              href="https://maps.google.com/?q=Gulu+Uganda"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark text-xs uppercase tracking-wider font-semibold px-4 py-2 rounded-sm transition-colors"
            >
              Google Maps
            </a>
          </div>
        </div>

        <!-- Google Map Iframe -->
        <div class="relative w-full h-[440px] sm:h-[520px] rounded-lg overflow-hidden border border-hotel-border/30 bg-hotel-charcoal shadow-2xl">
          <iframe
            title="The Northern Hotel Interactive Google Map"
            src={HOTEL_INFO.location.mapEmbedUrl}
            class="w-full h-full border-0 filter grayscale contrast-125 invert-[0.9] hue-rotate-180 opacity-90 hover:opacity-100 transition-opacity"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <!-- Transit logistics pills -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          {
            HOTEL_INFO.location.access.map((item) => (
              <div class="glass-card p-4 rounded-sm border border-white/5">
                <div class="text-[11px] uppercase tracking-wider text-hotel-gold font-medium mb-1">
                  {item.mode}
                </div>
                <p class="text-xs text-hotel-sand/80 font-light leading-relaxed">
                  {item.detail}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Folio & Inquiry Form Grid with Atmospheric Image Backdrop -->
  <section class="relative py-24 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden border-t border-white/5">
    <!-- Atmospheric Background Image Layer -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2200&q=80"
        alt="The Northern Night Facade"
        class="w-full h-full object-cover filter brightness-[0.20] contrast-125"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/85 to-hotel-dark"></div>
      <div class="ambient-glow -top-24 left-1/3 opacity-20"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left: Direct Channels (5 Cols) -->
      <div class="lg:col-span-5 space-y-6 kinetic-left">
        <div>
          <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold block mb-2">
            Direct Communication
          </span>
          <h2 class="font-serif text-3xl text-hotel-sand-light tracking-wide mb-3">
            Concierge & Management
          </h2>
          <p class="text-xs text-hotel-muted font-light leading-relaxed">
            Our guest relation specialists and head butler team operate uninterrupted around the clock.
          </p>
        </div>

        <div class="space-y-4">
          <div class="glass-panel p-5 rounded-lg border border-hotel-border/30">
            <div class="text-[10px] uppercase font-mono tracking-wider text-hotel-gold mb-1">Global Reservations</div>
            <a href={`tel:${HOTEL_INFO.contact.reservationsPhone}`} class="font-mono text-base text-hotel-sand-light hover:text-hotel-gold transition-colors block">
              {HOTEL_INFO.contact.reservationsPhone}
            </a>
            <div class="text-[11px] text-hotel-muted mt-1 font-light">Available 07:00 to 22:00 East Africa Time</div>
          </div>

          <div class="glass-panel p-5 rounded-lg border border-hotel-border/30">
            <div class="text-[10px] uppercase font-mono tracking-wider text-hotel-gold mb-1">24-Hour Duty Concierge & Security</div>
            <a href={`tel:${HOTEL_INFO.contact.conciergePhone}`} class="font-mono text-base text-hotel-sand-light hover:text-hotel-gold transition-colors block">
              {HOTEL_INFO.contact.conciergePhone}
            </a>
            <div class="text-[11px] text-hotel-muted mt-1 font-light">Direct desk line for arrival assistance and helipad coordinates</div>
          </div>

          <div class="glass-panel p-5 rounded-lg border border-hotel-border/30">
            <div class="text-[10px] uppercase font-mono tracking-wider text-hotel-gold mb-1">Electronic Enquiries</div>
            <a href={`mailto:${HOTEL_INFO.contact.email}`} class="text-sm text-hotel-sand-light hover:text-hotel-gold transition-colors block">
              {HOTEL_INFO.contact.email}
            </a>
            <a href={`mailto:${HOTEL_INFO.contact.conciergeEmail}`} class="text-xs text-hotel-muted hover:text-hotel-gold transition-colors block mt-1">
              {HOTEL_INFO.contact.conciergeEmail}
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Direct Inquiry Form (7 Cols) -->
      <div class="lg:col-span-7 glass-panel p-8 sm:p-10 rounded-xl border border-hotel-border/40 kinetic-right">
        <h3 class="font-serif text-2xl text-hotel-sand-light tracking-wide mb-2">
          Dispatch a Direct Message
        </h3>
        <p class="text-xs text-hotel-muted font-light mb-6">
          Our team ensures confidential, courteous responses to all guest inquiries.
        </p>

        <form id="contact-inquiry-form" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Full Name</label>
              <input type="text" id="contact-name" placeholder="Name" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
            </div>
            <div>
              <label for="contact-email" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Email Address</label>
              <input type="email" id="contact-email" placeholder="email@address.com" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-phone" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Phone Number (Optional)</label>
              <input type="tel" id="contact-phone" placeholder="+256 ..." class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
            </div>
            <div>
              <label for="contact-subject" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Enquiry Nature</label>
              <select id="contact-subject" class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand bg-hotel-charcoal">
                <option value="Suite Reservation">Suite or Villa Reservation</option>
                <option value="Spa and Wellness">Spa & Wellness Facility Inquiry</option>
                <option value="Helipad Access">Private Helipad & Flight Clearance</option>
                <option value="Event Inquiry">Conference or Diplomatic Summit</option>
                <option value="General Concierge">General Concierge Request</option>
              </select>
            </div>
          </div>

          <div>
            <label for="contact-message" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Message</label>
            <textarea id="contact-message" rows="4" placeholder="How may our concierge assist your upcoming visit?" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand"></textarea>
          </div>

          <div>
            <button
              type="submit"
              class="w-full bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold py-3.5 px-6 rounded-sm transition-colors shadow-lg"
            >
              Send Secure Message
            </button>
          </div>
        </form>

        <div id="contact-feedback" class="hidden text-center py-8 animate-fade-in">
          <span class="text-xs font-mono text-hotel-gold block mb-1">Message Dispatched</span>
          <h4 class="font-serif text-2xl text-hotel-sand-light">Thank You for Reaching Out</h4>
          <p class="text-xs text-hotel-muted mt-2">A concierge manager will review your communication and respond shortly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Guest Protocol & Frequently Asked Questions Accordion with Ambient Image Backdrop -->
  <section class="relative py-28 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden border-t border-white/5">
    <!-- Atmospheric Background Image Layer -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1591088398332-8a7791972843?auto=format&fit=crop&w=2200&q=80"
        alt="Artisanal Stonework Texture"
        class="w-full h-full object-cover filter brightness-[0.18] contrast-125"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/85 to-hotel-dark"></div>
      <div class="ambient-glow bottom-0 right-1/4 opacity-20"></div>
    </div>

    <div class="max-w-4xl mx-auto relative z-10">
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="text-xs uppercase tracking-[0.25em] text-hotel-gold font-semibold block mb-2">
          Concierge Guidance
        </span>
        <h3 class="font-serif text-3xl text-hotel-sand-light tracking-tight">
          Arrival Protocol & Guest Inquiries
        </h3>
      </div>

      <div class="space-y-4">
        <!-- Item 1 -->
        <div class="faq-item glass-panel rounded-lg border border-hotel-border/30 overflow-hidden transition-all duration-300">
          <button
            type="button"
            class="faq-trigger w-full p-6 text-left flex items-center justify-between text-hotel-sand-light hover:text-hotel-gold transition-colors focus:outline-none"
            aria-expanded="false"
          >
            <span class="font-serif text-lg">What are the hotel check-in and departure hours?</span>
            <svg class="faq-icon w-4 h-4 text-hotel-gold transform transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 px-6 pb-0">
            <p class="text-xs text-hotel-muted font-light leading-relaxed pb-6">
              Official check-in commences at 14:00, and suite check-out is requested by 11:00. Early arrivals and late departures are accommodated with pleasure, subject to room availability. Our concierge team secures luggage in private holding suites for guests arriving prior to check-in.
            </p>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="faq-item glass-panel rounded-lg border border-hotel-border/30 overflow-hidden transition-all duration-300">
          <button
            type="button"
            class="faq-trigger w-full p-6 text-left flex items-center justify-between text-hotel-sand-light hover:text-hotel-gold transition-colors focus:outline-none"
            aria-expanded="false"
          >
            <span class="font-serif text-lg">How are airport and regional transfers arranged?</span>
            <svg class="faq-icon w-4 h-4 text-hotel-gold transform transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 px-6 pb-0">
            <p class="text-xs text-hotel-muted font-light leading-relaxed pb-6">
              Complimentary chauffeured vehicle transfers are provided between Gulu Airport and the hotel grounds (10 minutes transit). For guests arriving from Entebbe International Airport or Kampala, we coordinate chartered flights, tarmac meet-and-greets, and private executive cruisers via Karuma Parkway.
            </p>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="faq-item glass-panel rounded-lg border border-hotel-border/30 overflow-hidden transition-all duration-300">
          <button
            type="button"
            class="faq-trigger w-full p-6 text-left flex items-center justify-between text-hotel-sand-light hover:text-hotel-gold transition-colors focus:outline-none"
            aria-expanded="false"
          >
            <span class="font-serif text-lg">Are executive security protocols and private helipads available?</span>
            <svg class="faq-icon w-4 h-4 text-hotel-gold transform transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 px-6 pb-0">
            <p class="text-xs text-hotel-muted font-light leading-relaxed pb-6">
              Yes. The Northern is equipped with a certified on-ground helipad with discrete coordinates shared following reservation confirmation. Our perimeter operates under 24-hour private diplomatic security protocols, secure subterranean parking, and encrypted communication lines.
            </p>
          </div>
        </div>

        <!-- Item 4 -->
        <div class="faq-item glass-panel rounded-lg border border-hotel-border/30 overflow-hidden transition-all duration-300">
          <button
            type="button"
            class="faq-trigger w-full p-6 text-left flex items-center justify-between text-hotel-sand-light hover:text-hotel-gold transition-colors focus:outline-none"
            aria-expanded="false"
          >
            <span class="font-serif text-lg">What is the dress code for dining and lounges?</span>
            <svg class="faq-icon w-4 h-4 text-hotel-gold transform transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 px-6 pb-0">
            <p class="text-xs text-hotel-muted font-light leading-relaxed pb-6">
              We observe an elegant smart-casual dress code at The Hearth Restaurant and Churchill Terrace & Bar during evening dinner services. Resort leisure attire is welcomed at The Pool Pavilion throughout the daytime.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initContact() {
    // FAQ accordion logic
    const faqTriggers = document.querySelectorAll('.faq-trigger');
    faqTriggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const parent = btn.closest('.faq-item');
        const content = parent?.querySelector('.faq-content') as HTMLElement;
        const icon = btn.querySelector('.faq-icon') as HTMLElement;
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        // Close all other items
        faqTriggers.forEach((otherBtn) => {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            const otherParent = otherBtn.closest('.faq-item');
            const otherContent = otherParent?.querySelector('.faq-content') as HTMLElement;
            const otherIcon = otherBtn.querySelector('.faq-icon') as HTMLElement;
            if (otherContent) otherContent.style.maxHeight = '0px';
            if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
          }
        });

        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          if (content) content.style.maxHeight = '0px';
          if (icon) icon.style.transform = 'rotate(0deg)';
        } else {
          btn.setAttribute('aria-expanded', 'true');
          if (content) content.style.maxHeight = `${content.scrollHeight}px`;
          if (icon) icon.style.transform = 'rotate(180deg)';
        }
      });
    });

    const contactForm = document.getElementById('contact-inquiry-form');
    const contactFeedback = document.getElementById('contact-feedback');
    contactForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (contactForm && contactFeedback) {
        contactForm.classList.add('hidden');
        contactFeedback.classList.remove('hidden');
      }
    });
  }

  document.addEventListener('astro:page-load', initContact);
</script>

