---
import Layout from '../layouts/Layout.astro';

const GALLERY_ITEMS = [
  {
    id: 'g-1',
    title: 'Twilight Horizon Pavilion',
    category: 'architecture',
    categoryLabel: 'Architecture',
    url: 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1800&q=85',
    caption: 'Main hotel pavilion at dusk, showing local volcanic stone facades and ambient water features.',
  },
  {
    id: 'g-2',
    title: 'Presidential Penthouse Master Chamber',
    category: 'suites',
    categoryLabel: 'Suites & Villas',
    url: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1800&q=85',
    caption: 'Top-floor penthouse suite with custom mahogany furnishings and panoramic northern views.',
  },
  {
    id: 'g-3',
    title: 'Open Hearth Charcoal Cooking',
    category: 'dining',
    categoryLabel: 'Gastronomy',
    url: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1800&q=85',
    caption: 'Executive culinary team preparing heirloom grains and grass-fed meats over wood-fired coals.',
  },
  {
    id: 'g-4',
    title: '30-Meter Heated Horizon Pool',
    category: 'wellness',
    categoryLabel: 'Wellness & Pools',
    url: 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=1800&q=85',
    caption: 'Heated outdoor swimming pool flanked by royal palms and private daybed cabanas.',
  },
  {
    id: 'g-5',
    title: 'Acholi Garden Villa Private Courtyard',
    category: 'suites',
    categoryLabel: 'Suites & Villas',
    url: 'https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=1800&q=85',
    caption: 'Enclosed volcanic stone garden courtyard featuring an outdoor rainfall bath.',
  },
  {
    id: 'g-6',
    title: 'Sunset Aperitivo on Churchill Terrace',
    category: 'dining',
    categoryLabel: 'Gastronomy',
    url: 'https://images.unsplash.com/photo-1551218808-94e220e084d2?auto=format&fit=crop&w=1800&q=85',
    caption: 'Handcrafted cocktails and single malts served beside stone fire pits as the sun sets.',
  },
  {
    id: 'g-7',
    title: 'The Aswa Spa Hydrotherapy Baths',
    category: 'wellness',
    categoryLabel: 'Wellness & Pools',
    url: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1800&q=85',
    caption: 'Private hydrotherapy soaking pools and holistic treatment chambers within the spa pavilion.',
  },
  {
    id: 'g-8',
    title: 'Executive Study & Boardroom Salon',
    category: 'architecture',
    categoryLabel: 'Architecture',
    url: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1800&q=85',
    caption: 'Solid teak boardroom table with acoustic paneling and encrypted video conferencing.',
  },
  {
    id: 'g-9',
    title: 'Terrace Deluxe Room Veranda',
    category: 'suites',
    categoryLabel: 'Suites & Villas',
    url: 'https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=1800&q=85',
    caption: 'Covered teak veranda with outdoor daybed overlooking the quiet western wing.',
  },
];
---

<Layout
  title="Visual Folio & Gallery | The Northern Grand Hotel, Gulu"
  description="Immerse yourself in the architectural beauty, executive suites, fine dining, and wellness facilities of The Northern Grand Hotel in Gulu Central."
  currentPath="/gallery"
>
  <!-- Page Header Banner -->
  <section class="relative pt-36 pb-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2200&q=80"
        alt="The Northern Architectural Folio"
        class="w-full h-full object-cover filter brightness-[0.38] contrast-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/60 to-hotel-dark/80"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 glass-panel px-4 py-1.5 rounded-full mb-4 border border-hotel-gold/30">
        <span class="w-1.5 h-1.5 rounded-full bg-hotel-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold">Visual Archive</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-hotel-sand-light tracking-tight mb-4">
        The Hotel Folio
      </h1>
      <p class="text-xs sm:text-base text-hotel-sand/90 font-light leading-relaxed max-w-2xl mx-auto">
        A photographic record of architectural restraint, indigenous volcanic stonework, contemporary interiors, and tranquil courtyards.
      </p>
    </div>
  </section>

  <!-- Gallery Section with Filters & Interactive Lightbox -->
  <section class="relative py-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden">
    <!-- Atmospheric background layer -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1578683010236-d716f9a3f461?auto=format&fit=crop&w=2200&q=80"
        alt="Stone Texture Backdrop"
        class="w-full h-full object-cover opacity-10 filter contrast-125"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-hotel-dark via-hotel-dark/90 to-hotel-dark"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <!-- Filter Switcher (Mobile Scrollable with Zero Cutoff) -->
      <div class="w-full overflow-x-auto scrollbar-none pb-4 mb-14 -mx-4 px-4 sm:mx-0 sm:px-0">
        <div class="flex items-center justify-start sm:justify-center gap-2.5 sm:gap-3.5 min-w-max">
          <button
            type="button"
            data-gallery-filter="all"
            class="gal-filter-btn px-5 sm:px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.16em] font-medium transition-all duration-300 bg-hotel-gold text-hotel-dark shadow-lg whitespace-nowrap cursor-pointer touch-manipulation active:scale-95"
          >
            All Photographs
          </button>
          <button
            type="button"
            data-gallery-filter="architecture"
            class="gal-filter-btn px-5 sm:px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.16em] font-medium transition-all duration-300 glass-card text-hotel-sand/90 hover:text-hotel-gold whitespace-nowrap cursor-pointer touch-manipulation active:scale-95"
          >
            Architecture
          </button>
          <button
            type="button"
            data-gallery-filter="suites"
            class="gal-filter-btn px-5 sm:px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.16em] font-medium transition-all duration-300 glass-card text-hotel-sand/90 hover:text-hotel-gold whitespace-nowrap cursor-pointer touch-manipulation active:scale-95"
          >
            Suites & Villas
          </button>
          <button
            type="button"
            data-gallery-filter="dining"
            class="gal-filter-btn px-5 sm:px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.16em] font-medium transition-all duration-300 glass-card text-hotel-sand/90 hover:text-hotel-gold whitespace-nowrap cursor-pointer touch-manipulation active:scale-95"
          >
            Gastronomy
          </button>
          <button
            type="button"
            data-gallery-filter="wellness"
            class="gal-filter-btn px-5 sm:px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.16em] font-medium transition-all duration-300 glass-card text-hotel-sand/90 hover:text-hotel-gold whitespace-nowrap cursor-pointer touch-manipulation active:scale-95"
          >
            Wellness & Pools
          </button>
        </div>
      </div>

      <!-- Masonry Editorial Photography Grid -->
      <div id="gallery-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {
          GALLERY_ITEMS.map((item, idx) => (
            <div
              data-cat={item.category}
              data-img-url={item.url}
              data-img-title={item.title}
              data-img-caption={item.caption}
              data-img-index={idx}
              class="gallery-item group relative rounded-lg overflow-hidden border border-hotel-border/40 bg-hotel-charcoal shadow-xl cursor-pointer h-72 sm:h-80 transition-all duration-500 hover:border-hotel-gold/60"
            >
              <img
                src={item.url}
                alt={item.title}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark/90 via-hotel-dark/30 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>

              <!-- Top Category Pill -->
              <div class="absolute top-4 left-4">
                <span class="glass-panel text-hotel-gold text-[10px] uppercase tracking-widest px-3 py-1.5 rounded-sm font-semibold">
                  {item.categoryLabel}
                </span>
              </div>

              <!-- Bottom Content Caption -->
              <div class="absolute bottom-4 left-4 right-4 space-y-1">
                <h3 class="font-serif text-lg text-hotel-sand-light group-hover:text-hotel-gold transition-colors">
                  {item.title}
                </h3>
                <p class="text-[11px] text-hotel-muted font-light line-clamp-2 leading-relaxed">
                  {item.caption}
                </p>
              </div>

              <!-- Expand Icon on Hover -->
              <div class="absolute top-4 right-4 w-8 h-8 rounded-full glass-panel flex items-center justify-center text-hotel-sand group-hover:text-hotel-gold group-hover:scale-110 transition-all opacity-0 group-hover:opacity-100">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Interactive Lightbox Modal -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-[120] bg-hotel-dark/95 backdrop-blur-2xl flex items-center justify-center p-4 sm:p-8 opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Image Preview"
  >
    <div class="relative w-full max-w-5xl flex flex-col items-center">
      <!-- Top Close Button & Counter -->
      <div class="w-full flex items-center justify-between pb-4 border-b border-white/10 mb-4">
        <span id="lb-counter" class="font-mono text-xs text-hotel-gold uppercase tracking-widest">
          1 of 9
        </span>
        <button
          id="lb-close"
          type="button"
          class="w-10 h-10 rounded-sm border border-hotel-gold/40 flex items-center justify-center text-hotel-sand hover:text-hotel-gold hover:border-hotel-gold transition-colors focus:outline-none cursor-pointer"
          aria-label="Close Lightbox"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Main Lightbox Photo Frame -->
      <div class="relative w-full h-[55vh] sm:h-[68vh] rounded-lg overflow-hidden border border-hotel-border/40 shadow-2xl bg-hotel-charcoal flex items-center justify-center">
        <img
          id="lb-img"
          src=""
          alt=""
          class="w-full h-full object-contain transition-opacity duration-300"
        />

        <!-- Left Nav Arrow -->
        <button
          id="lb-prev"
          type="button"
          class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full glass-panel flex items-center justify-center text-hotel-sand hover:text-hotel-gold hover:border-hotel-gold transition-all focus:outline-none cursor-pointer"
          aria-label="Previous Photograph"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <!-- Right Nav Arrow -->
        <button
          id="lb-next"
          type="button"
          class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full glass-panel flex items-center justify-center text-hotel-sand hover:text-hotel-gold hover:border-hotel-gold transition-all focus:outline-none cursor-pointer"
          aria-label="Next Photograph"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Bottom Caption Bar -->
      <div class="w-full pt-4 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-3">
        <div>
          <h4 id="lb-title" class="font-serif text-xl text-hotel-sand-light"></h4>
          <p id="lb-caption" class="text-xs text-hotel-muted font-light mt-1"></p>
        </div>
        <button
          type="button"
          data-open-reserve-modal
          class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold px-6 py-2.5 rounded-sm transition-colors cursor-pointer whitespace-nowrap"
        >
          Reserve Stay
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initGallery() {
    // Filter logic
    const filterBtns = document.querySelectorAll('.gal-filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-gallery-filter');
        if (!filter) return;

        filterBtns.forEach((b) => {
          b.classList.remove('bg-hotel-gold', 'text-hotel-dark', 'shadow-lg');
          b.classList.add('glass-card', 'text-hotel-sand/90');
        });

        btn.classList.add('bg-hotel-gold', 'text-hotel-dark', 'shadow-lg');
        btn.classList.remove('glass-card', 'text-hotel-sand/90');

        galleryItems.forEach((item) => {
          const itemCat = item.getAttribute('data-cat');
          const shouldShow = filter === 'all' || itemCat === filter;

          if (shouldShow) {
            (item as HTMLElement).style.display = 'block';
            (item as HTMLElement).style.opacity = '1';
          } else {
            (item as HTMLElement).style.display = 'none';
            (item as HTMLElement).style.opacity = '0';
          }
        });
      });
    });

    // Lightbox Modal Logic
    const lightboxModal = document.getElementById('lightbox-modal');
    const lbClose = document.getElementById('lb-close');
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    const lbTitle = document.getElementById('lb-title');
    const lbCaption = document.getElementById('lb-caption');
    const lbCounter = document.getElementById('lb-counter');
    const lbPrev = document.getElementById('lb-prev');
    const lbNext = document.getElementById('lb-next');

    let currentIndex = 0;
    const itemsArray = Array.from(galleryItems);

    function openLightbox(index: number) {
      if (!lightboxModal || !lbImg || !itemsArray[index]) return;
      currentIndex = index;
      const target = itemsArray[currentIndex];

      const url = target.getAttribute('data-img-url') || '';
      const title = target.getAttribute('data-img-title') || '';
      const caption = target.getAttribute('data-img-caption') || '';

      lbImg.src = url;
      if (lbTitle) lbTitle.textContent = title;
      if (lbCaption) lbCaption.textContent = caption;
      if (lbCounter) lbCounter.textContent = `${currentIndex + 1} of ${itemsArray.length}`;

      lightboxModal.classList.remove('opacity-0', 'pointer-events-none');
      lightboxModal.classList.add('opacity-100', 'pointer-events-auto');

      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightboxModal) return;
      lightboxModal.classList.remove('opacity-100', 'pointer-events-auto');
      lightboxModal.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    }

    function showNext() {
      let nextIndex = currentIndex + 1;
      if (nextIndex >= itemsArray.length) nextIndex = 0;
      openLightbox(nextIndex);
    }

    function showPrev() {
      let prevIndex = currentIndex - 1;
      if (prevIndex < 0) prevIndex = itemsArray.length - 1;
      openLightbox(prevIndex);
    }

    galleryItems.forEach((item, idx) => {
      item.addEventListener('click', () => {
        openLightbox(idx);
      });
    });

    lbClose?.addEventListener('click', closeLightbox);
    lbNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });
    lbPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });

    lightboxModal?.addEventListener('click', (e) => {
      if (e.target === lightboxModal) {
        closeLightbox();
      }
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (!lightboxModal || lightboxModal.classList.contains('pointer-events-none')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });
  }

  document.addEventListener('astro:page-load', initGallery);
</script>
