---
import Layout from '../layouts/Layout.astro';
import { EVENT_SPACES } from '../data/hotelData';
---

<Layout
  title="Gatherings & Summits | The Northern Grand Hotel, Gulu"
  description="Executive boardrooms, grand ballrooms, and open-air garden pavilions designed for international diplomatic summits, corporate retreats, and luxury private banquets."
  currentPath="/events"
>
  <!-- Page Header -->
  <section class="relative pt-36 pb-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=2200&q=80"
        alt="The Northern Event & Ballroom Spaces"
        class="w-full h-full object-cover filter brightness-[0.38] contrast-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/60 to-hotel-dark/80"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 glass-panel px-4 py-1.5 rounded-full mb-4 border border-hotel-gold/30">
        <span class="w-1.5 h-1.5 rounded-full bg-hotel-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold">Executive Venues & Summits</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-hotel-sand-light tracking-tight mb-4">
        Conferences & Private Galas
      </h1>
      <p class="text-xs sm:text-base text-hotel-sand/90 font-light leading-relaxed max-w-2xl mx-auto">
        State-of-the-art audiovisual infrastructure, dedicated security protocols, and bespoke banquet dining for international delegations and landmark celebrations.
      </p>
    </div>
  </section>

  <!-- Event Spaces Detailed Showcase -->
  <section class="py-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark">
    <div class="max-w-7xl mx-auto space-y-24">
      {
        EVENT_SPACES.map((space, idx) => {
          const isReversed = idx % 2 === 1;
          return (
            <div class="glass-panel p-6 sm:p-12 rounded-xl border border-hotel-border/40">
              <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
                <!-- Photo (6 Cols) -->
                <div class={`lg:col-span-6 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                  <div class="relative rounded-lg overflow-hidden border border-hotel-border/40 shadow-2xl h-[360px] sm:h-[440px]">
                    <img
                      src={space.image}
                      alt={space.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark/70 via-transparent to-transparent"></div>

                    <div class="absolute top-4 left-4 glass-panel px-3.5 py-1.5 rounded-sm">
                      <span class="text-[11px] font-mono tracking-widest text-hotel-gold">
                        {space.areaSqM} SQM
                      </span>
                    </div>

                    <!-- Capacity Pill overlay -->
                    <div class="absolute bottom-4 left-4 right-4 glass-panel p-3 rounded-sm grid grid-cols-3 text-center gap-2">
                      <div>
                        <div class="text-[9px] uppercase tracking-wider text-hotel-muted">Cocktail</div>
                        <div class="font-serif text-sm text-hotel-sand-light font-semibold">{space.capacityCocktail}</div>
                      </div>
                      <div>
                        <div class="text-[9px] uppercase tracking-wider text-hotel-muted">Banquet</div>
                        <div class="font-serif text-sm text-hotel-sand-light font-semibold">{space.capacityBanquet}</div>
                      </div>
                      <div>
                        <div class="text-[9px] uppercase tracking-wider text-hotel-muted">Theater</div>
                        <div class="font-serif text-sm text-hotel-sand-light font-semibold">{space.capacityTheater}</div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Text & Specifications (6 Cols) -->
                <div class={`lg:col-span-6 space-y-6 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                  <div>
                    <h2 class="font-serif text-3xl sm:text-4xl text-hotel-sand-light tracking-wide mb-3">
                      {space.name}
                    </h2>
                    <p class="text-xs sm:text-sm text-hotel-muted font-light leading-relaxed mb-6">
                      {space.description}
                    </p>
                  </div>

                  <div class="border-t border-white/10 pt-5 space-y-2.5">
                    <div class="text-[10px] uppercase tracking-[0.2em] text-hotel-gold font-semibold mb-3">
                      Architectural & Technical Features
                    </div>
                    {space.features.map((feature) => (
                      <div class="flex items-center gap-2.5 text-xs text-hotel-sand/90">
                        <svg class="w-3.5 h-3.5 text-hotel-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{feature}</span>
                      </div>
                    ))}
                  </div>

                  <div class="border-t border-white/10 pt-6">
                    <a
                      href="#event-inquiry"
                      class="inline-block bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold py-3.5 px-6 rounded-sm transition-all duration-300 shadow-lg text-center"
                    >
                      Request Venue Specification & Tariff
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Event RFP & Inquiry Form -->
  <section id="event-inquiry" class="py-20 px-4 sm:px-6 lg:px-12 bg-hotel-surface border-t border-white/5">
    <div class="max-w-3xl mx-auto glass-panel p-8 sm:p-12 rounded-xl border border-hotel-border/40">
      <div class="text-center max-w-xl mx-auto mb-8">
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold block mb-2">
          Private RFP Submission
        </span>
        <h3 class="font-serif text-3xl text-hotel-sand-light tracking-wide mb-3">
          Plan Your Executive Gathering
        </h3>
        <p class="text-xs sm:text-sm text-hotel-muted font-light">
          Our senior event directorship responds with comprehensive floor plans, technical riders, and catering proposals within 24 hours.
        </p>
      </div>

      <form id="event-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="event-org" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Organization / Host</label>
            <input type="text" id="event-org" placeholder="Company / Mission / Family" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
          </div>
          <div>
            <label for="event-type" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Gathering Format</label>
            <select id="event-type" class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand bg-hotel-charcoal">
              <option value="Diplomatic Summit">Diplomatic Summit / High-Level Meeting</option>
              <option value="Corporate Retreat">Corporate Retreat & Strategy Session</option>
              <option value="Banquet Gala">Banquet Gala & Private Celebration</option>
              <option value="Wedding Reception">Exclusive Wedding Reception</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="event-date" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Proposed Date</label>
            <input type="date" id="event-date" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
          </div>
          <div>
            <label for="event-attendees" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Estimated Guests</label>
            <input type="number" id="event-attendees" min="10" max="600" placeholder="e.g. 50" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
          </div>
          <div>
            <label for="event-space" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Preferred Space</label>
            <select id="event-space" class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand bg-hotel-charcoal">
              <option value="The Grand Karuma Ballroom">The Grand Karuma Ballroom</option>
              <option value="The Acholi Executive Boardroom">The Acholi Executive Boardroom</option>
              <option value="The Sunken Pavilion Gardens">The Sunken Pavilion Gardens</option>
              <option value="Full Estate Buyout">Full Estate Buyout</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="event-contact-name" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Lead Contact Person</label>
            <input type="text" id="event-contact-name" placeholder="Full Name & Title" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
          </div>
          <div>
            <label for="event-contact-email" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Official Email Address</label>
            <input type="email" id="event-contact-email" placeholder="official@domain.com" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
          </div>
        </div>

        <div>
          <label for="event-notes" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Security, Technical or Protocol Specifications</label>
          <textarea id="event-notes" rows="3" placeholder="Provide information on interpretation, VIP holding suites, vehicular security, or dietary requirements." class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand"></textarea>
        </div>

        <div class="text-center pt-2">
          <button
            type="submit"
            class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold px-8 py-3.5 rounded-sm transition-colors shadow-lg"
          >
            Submit Event Request
          </button>
        </div>
      </form>

      <div id="event-feedback" class="hidden text-center py-6 animate-fade-in">
        <span class="text-xs font-mono text-hotel-gold block mb-1">Event Folio Logged</span>
        <h3 class="font-serif text-2xl text-hotel-sand-light">Proposal Under Review</h3>
        <p class="text-xs text-hotel-muted mt-2">Thank you. Our Director of Events will contact you with full floorplans and technical riders within one business day.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const eventForm = document.getElementById('event-form');
  const eventFeedback = document.getElementById('event-feedback');
  eventForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (eventForm && eventFeedback) {
      eventForm.classList.add('hidden');
      eventFeedback.classList.remove('hidden');
    }
  });
</script>

