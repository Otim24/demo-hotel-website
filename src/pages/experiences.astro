---
import Layout from '../layouts/Layout.astro';
import { EXPERIENCES } from '../data/hotelData';
---

<Layout
  title="Safari & Excursions | The Northern Grand Hotel, Gulu"
  description="Private air charters to Kidepo Valley National Park, guided treks to Aruu Cascades, living Acholi cultural masterclasses, and nocturnal savanna astronomy."
  currentPath="/experiences"
>
  <!-- Page Header Banner -->
  <section class="relative pt-36 pb-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=2200&q=80"
        alt="Northern Savanna Wilderness Expedition"
        class="w-full h-full object-cover filter brightness-[0.38] contrast-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/60 to-hotel-dark/80"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 glass-panel px-4 py-1.5 rounded-full mb-4 border border-hotel-gold/30">
        <span class="w-1.5 h-1.5 rounded-full bg-hotel-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold">Wilderness & Heritage Expeditions</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-hotel-sand-light tracking-tight mb-4">
        The Northern Wilderness
      </h1>
      <p class="text-xs sm:text-base text-hotel-sand/90 font-light leading-relaxed max-w-2xl mx-auto">
        Northern Uganda holds some of Africa's most dramatic, untouched natural landscapes. We curate private air charters, expert-led game tracking, and respectful cultural encounters.
      </p>
    </div>
  </section>

  <!-- Detailed Experiences Grid -->
  <section class="py-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark">
    <div class="max-w-7xl mx-auto space-y-20">
      {
        EXPERIENCES.map((exp, idx) => {
          const isReversed = idx % 2 === 1;
          return (
            <div class="glass-panel p-6 sm:p-10 rounded-xl border border-hotel-border/40">
              <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
                <!-- Photo (6 Cols) -->
                <div class={`lg:col-span-6 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                  <div class="relative rounded-lg overflow-hidden border border-hotel-border/40 shadow-2xl h-[360px] sm:h-[440px]">
                    <img
                      src={exp.image}
                      alt={exp.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark/70 via-transparent to-transparent"></div>

                    <div class="absolute top-4 left-4 flex gap-2">
                      <span class="glass-panel text-hotel-gold text-[10px] uppercase tracking-widest px-3 py-1.5 rounded-sm font-semibold">
                        {exp.badge}
                      </span>
                      <span class="glass-panel text-hotel-sand-light text-[10px] font-mono px-3 py-1.5 rounded-sm">
                        {exp.duration}
                      </span>
                    </div>

                    <div class="absolute bottom-4 left-4 right-4 glass-panel p-3 rounded-sm flex items-center justify-between text-xs">
                      <span class="text-hotel-sand-light font-medium">{exp.category}</span>
                      <span class="text-hotel-gold font-mono">{exp.schedule}</span>
                    </div>
                  </div>
                </div>

                <!-- Text & Provisions (6 Cols) -->
                <div class={`lg:col-span-6 space-y-5 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                  <div>
                    <h2 class="font-serif text-3xl sm:text-4xl text-hotel-sand-light tracking-wide mb-3">
                      {exp.title}
                    </h2>
                    <p class="text-xs sm:text-sm text-hotel-muted font-light leading-relaxed mb-6">
                      {exp.description}
                    </p>
                  </div>

                  <div class="border-t border-white/10 pt-5 space-y-2.5">
                    <div class="text-[10px] uppercase tracking-[0.2em] text-hotel-gold font-semibold">
                      Private Inclusions & Amenities
                    </div>
                    {exp.included.map((item) => (
                      <div class="flex items-center gap-2.5 text-xs text-hotel-sand/85">
                        <svg class="w-3.5 h-3.5 text-hotel-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>

                  <div class="border-t border-white/10 pt-6">
                    <button
                      type="button"
                      data-open-reserve-modal
                      class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold py-3.5 px-6 rounded-sm transition-all duration-300 shadow-lg text-center"
                    >
                      Inquire Expedition Booking
                    </button>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Fleet & Aviation Inclusions -->
  <section class="py-20 px-4 sm:px-6 lg:px-12 bg-hotel-surface border-t border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="text-xs uppercase tracking-[0.25em] text-hotel-gold font-semibold block mb-2">
          Expedition Infrastructure
        </span>
        <h3 class="font-serif text-3xl text-hotel-sand-light tracking-tight">
          Uncompromised Safety & Travel Luxury
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="glass-card p-6 rounded-lg space-y-4">
          <div class="w-10 h-10 rounded-full border border-hotel-gold/30 flex items-center justify-center text-hotel-gold">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
          <h4 class="font-serif text-xl text-hotel-sand-light">Private Air Charter</h4>
          <p class="text-xs text-hotel-muted font-light leading-relaxed">
            Direct departures from Gulu Airport and our private estate helipad to Kidepo Valley airstrips in 45 minutes flat, bypassing lengthy overland transit.
          </p>
        </div>

        <div class="glass-card p-6 rounded-lg space-y-4">
          <div class="w-10 h-10 rounded-full border border-hotel-gold/30 flex items-center justify-center text-hotel-gold">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
            </svg>
          </div>
          <h4 class="font-serif text-xl text-hotel-sand-light">Custom 4x4 Cruisers</h4>
          <p class="text-xs text-hotel-muted font-light leading-relaxed">
            Extended-body Toyota Land Cruisers fitted with high-frequency radio, pop-up 360-degree photography roofs, individual refrigerator consoles, and charging ports.
          </p>
        </div>

        <div class="glass-card p-6 rounded-lg space-y-4">
          <div class="w-10 h-10 rounded-full border border-hotel-gold/30 flex items-center justify-center text-hotel-gold">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h4 class="font-serif text-xl text-hotel-sand-light">Senior Naturalists</h4>
          <p class="text-xs text-hotel-muted font-light leading-relaxed">
            Led exclusively by certified professional safari guides with decades of tracking experience in the northern savannas and Karamoja region.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
