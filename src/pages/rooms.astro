---
import Layout from '../layouts/Layout.astro';
import { ROOMS } from '../data/hotelData';
---

<Layout
  title="Accommodations | The Northern Grand Hotel & Safari Sanctuary"
  description="Explore our bespoke suites and private villas in Northern Uganda. Each residence features indigenous stone craftsmanship, panoramic savanna terraces, and dedicated butler service."
  currentPath="/rooms"
>
  <!-- Page Header Banner -->
  <section class="relative pt-36 pb-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=2200&q=80"
        alt="The Northern Accommodations Overview"
        class="w-full h-full object-cover filter brightness-[0.4] contrast-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/60 to-hotel-dark/80"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 glass-panel px-4 py-1.5 rounded-full mb-4 border border-hotel-gold/30">
        <span class="w-1.5 h-1.5 rounded-full bg-hotel-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold">The Private Residences</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-hotel-sand-light tracking-tight mb-4">
        Accommodations & Sanctuaries
      </h1>
      <p class="max-w-2xl mx-auto text-xs sm:text-base text-hotel-sand/90 font-light leading-relaxed">
        Crafted with local volcanic basalt, hand-hewn mahogany, and expansive glass walls that open directly onto the northern horizon. Every stay includes around-the-clock private butler service.
      </p>
    </div>
  </section>

  <!-- Filter & Presentation Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-12 bg-hotel-dark relative">
    <div class="max-w-7xl mx-auto">
      <!-- Filter Switcher -->
      <div class="flex items-center justify-center gap-3 mb-16 overflow-x-auto pb-2">
        <button
          type="button"
          data-filter="all"
          class="filter-btn px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 bg-hotel-gold text-hotel-dark shadow-lg"
        >
          All Residences
        </button>
        <button
          type="button"
          data-filter="suite"
          class="filter-btn px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 glass-card text-hotel-sand/80 hover:text-hotel-gold"
        >
          Signature Suites
        </button>
        <button
          type="button"
          data-filter="villa"
          class="filter-btn px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 glass-card text-hotel-sand/80 hover:text-hotel-gold"
        >
          Private Villas
        </button>
        <button
          type="button"
          data-filter="executive"
          class="filter-btn px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 glass-card text-hotel-sand/80 hover:text-hotel-gold"
        >
          Executive Folio
        </button>
      </div>

      <!-- Dynamic Room Showcases (Alternating Editorial Spreads) -->
      <div class="space-y-24">
        {
          ROOMS.map((room, idx) => {
            const isReversed = idx % 2 === 1;
            return (
              <div
                id={room.id}
                data-category={room.category}
                class="room-card-item scroll-mt-28 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
              >
                <!-- Image & Mini Gallery (7 Cols) -->
                <div class={`lg:col-span-7 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                  <div class="relative rounded-lg overflow-hidden border border-hotel-border/40 shadow-2xl group h-[400px] sm:h-[480px]">
                    <img
                      id={`page-room-img-${room.id}`}
                      src={room.heroImage}
                      alt={room.name}
                      class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark/80 via-transparent to-transparent"></div>

                    <!-- Dimension Pill -->
                    <div class="absolute top-4 left-4 glass-panel px-3.5 py-1.5 rounded-sm">
                      <span class="text-[11px] font-mono tracking-widest text-hotel-sand-light uppercase">
                        {room.sizeSqM} SQM / {Math.round(room.sizeSqM * 10.764)} SQFT
                      </span>
                    </div>

                    <!-- Bottom Bar with Thumbnails & Direct Price -->
                    <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        {room.gallery.map((thumbUrl) => (
                          <button
                            type="button"
                            data-target-img={thumbUrl}
                            data-room-target={room.id}
                            class="room-page-thumb w-14 h-10 rounded-sm overflow-hidden border border-white/30 hover:border-hotel-gold transition-all"
                            aria-label="View room photograph"
                          >
                            <img src={thumbUrl} alt="" class="w-full h-full object-cover" />
                          </button>
                        ))}
                      </div>

                      <div class="glass-panel px-4 py-2 rounded-sm text-right">
                        <span class="text-[10px] uppercase tracking-wider text-hotel-muted block">Tariff</span>
                        <span class="font-serif text-xl text-hotel-gold font-semibold">${room.pricePerNight}</span>
                        <span class="text-[10px] text-hotel-sand/70 uppercase"> / Night</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Editorial Specifications (5 Cols) -->
                <div class={`lg:col-span-5 glass-panel p-6 sm:p-10 rounded-lg border border-hotel-border/40 space-y-6 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                  <div>
                    <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-4">
                      <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-hotel-gold">
                        Category: {room.category.toUpperCase()}
                      </span>
                      <span class="text-xs text-hotel-sand/80 font-sans">{room.occupancy}</span>
                    </div>

                    <h2 class="font-serif text-2xl sm:text-3xl text-hotel-sand-light mb-2">
                      {room.name}
                    </h2>

                    <div class="text-xs uppercase tracking-wider text-hotel-gold/90 mb-4 font-medium">
                      {room.tagline}
                    </div>

                    <p class="text-xs sm:text-sm text-hotel-muted font-light leading-relaxed mb-6">
                      {room.description}
                    </p>

                    <!-- Key Spec Grid -->
                    <div class="grid grid-cols-2 gap-3 mb-6">
                      {room.highlights.map((h) => (
                        <div class="glass-card p-3 rounded-sm border border-white/5">
                          <div class="text-[10px] uppercase tracking-wider text-hotel-muted">{h.label}</div>
                          <div class="text-xs text-hotel-sand-light font-medium truncate">{h.value}</div>
                        </div>
                      ))}
                    </div>

                    <!-- Amenities list -->
                    <div class="border-t border-white/10 pt-5 space-y-2">
                      <div class="text-[10px] uppercase tracking-[0.2em] text-hotel-sand-light font-semibold mb-2">
                        Residence Provisions
                      </div>
                      {room.amenities.slice(0, 4).map((amenity) => (
                        <div class="flex items-center gap-2 text-xs text-hotel-sand/85">
                          <svg class="w-3.5 h-3.5 text-hotel-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{amenity}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="border-t border-white/10 pt-6">
                    <button
                      type="button"
                      data-open-reserve-modal
                      data-room-id={room.id}
                      class="w-full bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold py-3.5 px-6 rounded-sm transition-all duration-300 shadow-lg text-center"
                    >
                      Reserve {room.name}
                    </button>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Included Signature Inclusions Banner -->
  <section class="py-20 px-4 sm:px-6 lg:px-12 bg-hotel-surface border-t border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-[0.25em] text-hotel-gold font-semibold block mb-2">
          Sanctuary Standard
        </span>
        <h3 class="font-serif text-3xl text-hotel-sand-light tracking-tight">
          Every Reservation Includes
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card p-6 rounded-lg text-center space-y-3">
          <div class="w-12 h-12 mx-auto rounded-full border border-hotel-gold/30 flex items-center justify-center text-hotel-gold">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h4 class="font-serif text-lg text-hotel-sand-light">24-Hour Butler Service</h4>
          <p class="text-xs text-hotel-muted font-light leading-relaxed">
            Unpacking, garment pressing, customized safari packing, and private in-suite dining arrangement.
          </p>
        </div>

        <div class="glass-card p-6 rounded-lg text-center space-y-3">
          <div class="w-12 h-12 mx-auto rounded-full border border-hotel-gold/30 flex items-center justify-center text-hotel-gold">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h4 class="font-serif text-lg text-hotel-sand-light">Artisanal Breakfast</h4>
          <p class="text-xs text-hotel-muted font-light leading-relaxed">
            Daily gourmet breakfast served either on your private veranda or within The Savanna Hearth.
          </p>
        </div>

        <div class="glass-card p-6 rounded-lg text-center space-y-3">
          <div class="w-12 h-12 mx-auto rounded-full border border-hotel-gold/30 flex items-center justify-center text-hotel-gold">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h4 class="font-serif text-lg text-hotel-sand-light">Fiber Optic Network</h4>
          <p class="text-xs text-hotel-muted font-light leading-relaxed">
            Encrypted high-speed symmetric internet with private bandwidth allocations in every residence.
          </p>
        </div>

        <div class="glass-card p-6 rounded-lg text-center space-y-3">
          <div class="w-12 h-12 mx-auto rounded-full border border-hotel-gold/30 flex items-center justify-center text-hotel-gold">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h4 class="font-serif text-lg text-hotel-sand-light">Bespoke Botanicals</h4>
          <p class="text-xs text-hotel-muted font-light leading-relaxed">
            Organic skincare and bath oils cold-formulated by local herbalists from northern wild botanicals.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Filter switching logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const roomItems = document.querySelectorAll('.room-card-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      if (!filter) return;

      filterBtns.forEach((b) => {
        b.classList.remove('bg-hotel-gold', 'text-hotel-dark', 'shadow-lg');
        b.classList.add('glass-card', 'text-hotel-sand/80');
      });

      btn.classList.add('bg-hotel-gold', 'text-hotel-dark', 'shadow-lg');
      btn.classList.remove('glass-card', 'text-hotel-sand/80');

      roomItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (filter === 'all' || itemCat === filter) {
          (item as HTMLElement).style.display = 'grid';
          setTimeout(() => {
            (item as HTMLElement).style.opacity = '1';
          }, 30);
        } else {
          (item as HTMLElement).style.opacity = '0';
          setTimeout(() => {
            (item as HTMLElement).style.display = 'none';
          }, 250);
        }
      });
    });
  });

  // Photo switcher in room folio
  const roomThumbs = document.querySelectorAll('.room-page-thumb');
  roomThumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const parentId = thumb.getAttribute('data-room-target');
      const targetUrl = thumb.getAttribute('data-target-img');
      if (!parentId || !targetUrl) return;

      const mainImg = document.getElementById(`page-room-img-${parentId}`) as HTMLImageElement;
      if (mainImg) {
        mainImg.style.opacity = '0.3';
        setTimeout(() => {
          mainImg.src = targetUrl;
          mainImg.style.opacity = '1';
        }, 180);
      }
    });
  });
</script>
