---
import Layout from '../layouts/Layout.astro';
import { HOTEL_AMENITIES } from '../data/hotelData';

const SPA_TREATMENTS = [
  {
    name: 'Aswa River Heated Basalt Ritual',
    duration: '90 Minutes',
    category: 'Holistic Bodywork',
    description: 'Smooth river basalt stones gently warmed with organic cold-pressed shea oil to release deep muscular tension and restore circulation.',
    price: '$160',
  },
  {
    name: 'Northern Botanical Herb Exfoliation',
    duration: '60 Minutes',
    category: 'Skin Renewal',
    description: 'Crushed heirloom golden millet, raw forest honeycomb, and sweet almond oil gently buff the skin, followed by a warm herbal sage mist.',
    price: '$120',
  },
  {
    name: 'Acacia Vitality Deep Tissue Massage',
    duration: '75 Minutes',
    category: 'Therapeutic Bodywork',
    description: 'Targeted muscular restoration utilizing stimulating camphor and wild frankincense, designed for travelers seeking physical renewal.',
    price: '$145',
  },
  {
    name: 'Twilight Sound & Breath Meditation',
    duration: '60 Minutes',
    category: 'Meditation & Acoustic Healing',
    description: 'Acoustic evening meditation held in the open-air cedar pavilion with hand-hammered bronze singing bowls and bamboo chimes.',
    price: '$95',
  },
];
---

<Layout
  title="Hotel Amenities & Spa | The Northern Grand Hotel, Gulu"
  description="Explore our 30-meter horizon swimming pool, The Aswa Holistic Wellness Spa, 24-hour Technogym fitness center, and private executive library lounge."
  currentPath="/amenities"
>
  <!-- Page Header Banner -->
  <section class="relative pt-36 pb-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=2200&q=80"
        alt="The Aswa Wellness Spa at The Northern"
        class="w-full h-full object-cover filter brightness-[0.38] contrast-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/60 to-hotel-dark/80"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 glass-panel px-4 py-1.5 rounded-full mb-4 border border-hotel-gold/30">
        <span class="w-1.5 h-1.5 rounded-full bg-hotel-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold">Leisure & Wellness Folio</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-hotel-sand-light tracking-tight mb-4">
        Hotel Amenities & Spa
      </h1>
      <p class="text-xs sm:text-base text-hotel-sand/90 font-light leading-relaxed max-w-2xl mx-auto">
        Designed for physical restoration and quiet focus. Enjoy heated swimming pools, holistic hydrotherapy, high-performance fitness facilities, and private executive salons.
      </p>
    </div>
  </section>

  <!-- Detailed Amenities List with Atmospheric Backdrop -->
  <section class="py-20 px-4 sm:px-6 lg:px-12 bg-hotel-dark relative overflow-hidden">
    <!-- Atmospheric architectural background layer -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=2200&q=80"
        alt="Wellness & Resort Architecture Texture"
        class="w-full h-full object-cover opacity-15 filter brightness-40 contrast-125"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-hotel-dark via-hotel-dark/90 to-hotel-dark"></div>
      <div class="ambient-glow top-1/4 left-0 opacity-20"></div>
    </div>

    <div class="max-w-7xl mx-auto space-y-20 relative z-10">
      {
        HOTEL_AMENITIES.map((amenity, idx) => {
          const isReversed = idx % 2 === 1;
          return (
            <div class="glass-panel p-6 sm:p-10 rounded-xl border border-hotel-border/40 kinetic-block">
              <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
                <!-- Photo (6 Cols) -->
                <div class={`lg:col-span-6 ${isReversed ? 'lg:order-2 kinetic-right' : 'lg:order-1 kinetic-left'}`}>
                  <div class="relative rounded-lg overflow-hidden border border-hotel-border/40 shadow-2xl h-[360px] sm:h-[440px]">
                    <img
                      src={amenity.image}
                      alt={amenity.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark/70 via-transparent to-transparent"></div>

                    <div class="absolute top-4 left-4 flex gap-2">
                      <span class="glass-panel text-hotel-gold text-[10px] uppercase tracking-widest px-3 py-1.5 rounded-sm font-semibold">
                        {amenity.badge}
                      </span>
                      <span class="glass-panel text-hotel-sand-light text-[10px] font-mono px-3 py-1.5 rounded-sm">
                        {amenity.category}
                      </span>
                    </div>

                    <div class="absolute bottom-4 left-4 right-4 glass-panel p-3 rounded-sm flex items-center justify-between text-xs">
                      <span class="text-hotel-sand-light font-medium">{amenity.subtitle}</span>
                      <span class="text-hotel-gold font-mono">{amenity.hours}</span>
                    </div>
                  </div>
                </div>

                <!-- Text & Specifications (6 Cols) -->
                <div class={`lg:col-span-6 space-y-5 ${isReversed ? 'lg:order-1 kinetic-left' : 'lg:order-2 kinetic-right'}`}>
                  <div>
                    <span class="text-[10px] uppercase tracking-widest text-hotel-gold font-mono block mb-1">
                      {amenity.hours}
                    </span>
                    <h2 class="font-serif text-3xl sm:text-4xl text-hotel-sand-light tracking-wide mb-3">
                      {amenity.title}
                    </h2>
                    <p class="text-xs sm:text-sm text-hotel-muted font-light leading-relaxed mb-6">
                      {amenity.description}
                    </p>
                  </div>

                  <div class="border-t border-white/10 pt-5 space-y-2.5">
                    <div class="text-[10px] uppercase tracking-[0.2em] text-hotel-gold font-semibold">
                      Key Provisions
                    </div>
                    {amenity.highlights.map((item) => (
                      <div class="flex items-center gap-2.5 text-xs text-hotel-sand/85">
                        <svg class="w-3.5 h-3.5 text-hotel-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>

                  <div class="border-t border-white/10 pt-6">
                    <a
                      href="#spa-inquiry"
                      class="inline-block bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold py-3.5 px-6 rounded-sm transition-all duration-300 shadow-lg text-center"
                    >
                      Inquire or Reserve Facility
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- The Aswa Spa Treatment Menu Preview with Atmospheric Image Backdrop -->
  <section class="relative py-28 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden border-t border-white/5">
    <!-- Atmospheric Background Image Layer -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=2200&q=80"
        alt="The Aswa Spa Hydrotherapy Waters"
        class="w-full h-full object-cover filter brightness-[0.20] contrast-125"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/85 to-hotel-dark"></div>
      <div class="ambient-glow -top-32 right-1/4 opacity-25"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="text-center max-w-xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-[0.25em] text-hotel-gold font-semibold block mb-2">
          The Aswa Spa Menu
        </span>
        <h3 class="font-serif text-3xl sm:text-4xl text-hotel-sand-light tracking-tight">
          Holistic Rituals & Restorative Therapies
        </h3>
        <p class="text-xs sm:text-sm text-hotel-muted mt-3 font-light">
          Each treatment uses bespoke botanical oils and local herbal ingredients cold-pressed specifically for our spa suites.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          SPA_TREATMENTS.map((treatment) => (
            <div class="glass-panel p-6 sm:p-8 rounded-lg border border-hotel-border/40 hover:border-hotel-gold/40 transition-colors space-y-4">
              <div class="flex items-baseline justify-between gap-4 border-b border-white/10 pb-3">
                <div>
                  <h4 class="font-serif text-xl text-hotel-sand-light">{treatment.name}</h4>
                  <span class="text-[10px] uppercase font-mono tracking-wider text-hotel-gold">{treatment.category} | {treatment.duration}</span>
                </div>
                <span class="font-serif text-2xl text-hotel-gold font-semibold">{treatment.price}</span>
              </div>
              <p class="text-xs text-hotel-muted font-light leading-relaxed">
                {treatment.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Spa & Facility Reservation Form with Ambient Image Backdrop -->
  <section id="spa-inquiry" class="relative py-28 px-4 sm:px-6 lg:px-12 bg-hotel-dark overflow-hidden border-t border-white/5">
    <!-- Atmospheric Background Image Layer -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=2200&q=80"
        alt="The Pool Pavilion Twilight Reflection"
        class="w-full h-full object-cover filter brightness-[0.20] contrast-125"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-hotel-dark via-hotel-dark/85 to-hotel-dark"></div>
      <div class="ambient-glow bottom-0 left-1/4 opacity-20"></div>
    </div>

    <div class="max-w-3xl mx-auto relative z-10 glass-panel-heavy p-8 sm:p-14 rounded-xl border border-hotel-border/40 shadow-2xl">
      <div class="text-center max-w-xl mx-auto mb-8">
        <span class="text-[11px] uppercase tracking-[0.25em] text-hotel-gold font-semibold block mb-2">
          Facility Concierge
        </span>
        <h3 class="font-serif text-3xl text-hotel-sand-light tracking-wide mb-3">
          Reserve a Spa Treatment or Cabana
        </h3>
        <p class="text-xs sm:text-sm text-hotel-muted font-light">
          Our wellness concierge confirms availability and coordinates your treatment timing.
        </p>
      </div>

      <form id="spa-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="spa-name" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Guest Name</label>
            <input type="text" id="spa-name" placeholder="Name" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
          </div>
          <div>
            <label for="spa-contact" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Email / Phone</label>
            <input type="text" id="spa-contact" placeholder="Email or Phone" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="spa-facility" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Service / Facility</label>
            <select id="spa-facility" class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand bg-hotel-charcoal">
              <option value="Aswa Heated Stone Ritual">Aswa Heated Stone Ritual</option>
              <option value="Botanical Herb Exfoliation">Botanical Herb Exfoliation</option>
              <option value="Acacia Vitality Deep Tissue">Acacia Vitality Deep Tissue</option>
              <option value="Poolside Private Cabana">Poolside Private Cabana</option>
              <option value="Personal Training Session">Personal Training Session</option>
            </select>
          </div>
          <div>
            <label for="spa-date" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Preferred Date</label>
            <input type="date" id="spa-date" required class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand" />
          </div>
          <div>
            <label for="spa-time" class="block text-[11px] uppercase tracking-wider text-hotel-sand font-medium mb-1">Preferred Time</label>
            <select id="spa-time" class="w-full glass-input px-3.5 py-2.5 rounded-sm text-xs text-hotel-sand bg-hotel-charcoal">
              <option value="Morning">09:00 - 12:00 Morning</option>
              <option value="Afternoon" selected>13:00 - 17:00 Afternoon</option>
              <option value="Evening">18:00 - 20:00 Evening</option>
            </select>
          </div>
        </div>

        <div class="text-center pt-2">
          <button
            type="submit"
            class="bg-hotel-gold hover:bg-hotel-gold-light text-hotel-dark font-sans text-xs tracking-[0.2em] uppercase font-semibold px-8 py-3.5 rounded-sm transition-colors shadow-lg"
          >
            Submit Wellness Reservation
          </button>
        </div>
      </form>

      <div id="spa-feedback" class="hidden text-center py-6 animate-fade-in">
        <span class="text-xs font-mono text-hotel-gold block mb-1">Reservation Request Received</span>
        <h4 class="font-serif text-2xl text-hotel-sand-light">Spa Concierge Will Confirm</h4>
        <p class="text-xs text-hotel-muted mt-2">Thank you. Your appointment request has been dispatched to our spa director.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initAmenities() {
    const spaForm = document.getElementById('spa-form');
    const spaFeedback = document.getElementById('spa-feedback');
    const spaDate = document.getElementById('spa-date') as HTMLInputElement;

    if (spaDate && !spaDate.value) {
      const today = new Date();
      today.setDate(today.getDate() + 1);
      spaDate.min = today.toISOString().split('T')[0];
      spaDate.value = today.toISOString().split('T')[0];
    }

    spaForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (spaForm && spaFeedback) {
        spaForm.classList.add('hidden');
        spaFeedback.classList.remove('hidden');
      }
    });
  }

  document.addEventListener('astro:page-load', initAmenities);
</script>

