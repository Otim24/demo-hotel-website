{
  "name": "the-northern-hotel",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=/tmp astro dev --host 0.0.0.0",
    "start": "npm run dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=/tmp astro build",
